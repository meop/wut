      packOpAdd 'xbps' \$\\"use xbps \\\\(system\\\\)\\" { |n| packGrepFind [\$\\"(\$cmd)-query\\" --repository --search] \$n } [\$\\"(\$cmd)-install\\"]
    }
    info => {
      packOpInfo [\$\\"(\$cmd)-query\\" --repository --show]
    }
    list => {
