packFindSearch

} catch { |e|
  let shireSettled = (try { do { }; false } catch { true })
  if \$shireSettled or (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {
