    }
    find => {
      packOp [\$cmd update]
      packOpFind [\$cmd search]
    }
    info => {
      packOp [\$cmd update]
      packOpInfo [\$cmd info]
    }
    list => {
      packOpList [\$cmd list]
    }
    outdated => {
      packOp [\$cmd update]
      packOpOutdated [\$cmd status]
    }
    remove => {
      packOpRemove 'scoop' \$\\"use scoop \\\\(user\\\\)\\" { |n| packGrepList [\$cmd list] \$n } [\$cmd uninstall --purge]
    }
    sync => {
      packOp [\$cmd update]
      packOpSync [\$cmd update --all] [\$cmd update]
    }
    tidy => {
