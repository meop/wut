def --env packEmerge [] {
  let mgr = 'emerge'
  if (packSkip \$mgr) {
    return
  }

  let cmd = packElevate \$mgr

  packRefreshForOp \$mgr

  match \$env.PACK_OP {
    add => {
      # --noreplace: a name already here is recorded in world, not rebuilt
      packOpAdd [\$cmd --noreplace]
    }
    info => {
      # a bare term is a prefix to --search, so git answers with git-lfs and two dozen more; a % prefix makes it a
      # regex, which the anchors pin to the one name, and @ matches it against category/name, which a whole name is
      for term in (packInfoNames) {
        let key = if (\$term | str contains '/') { \$\\"%@^(\$term)\$\\" } else { \$\\"%^(\$term)\$\\" }
        packDo [\$cmd --search \$key]
      }
    }
    list => {
      packOpList (packListCmd \$mgr)
    }
    outdated => {
      packOpOutdated [\$cmd --pretend --update --deep --newuse '@world']
    }
    remove => {
      # depclean with a name unmerges it and drops it from world, and refuses while anything still depends on it
      packOpRemove [\$cmd --depclean]
    }
    sync => {
      packOpSync [\$cmd --update --deep --newuse '@world'] [\$cmd --update]
    }
    tidy => {
      packOp [\$cmd --depclean]
    }
  }
}


def --env packXbps [] {
  let mgr = 'xbps'
  if (packSkip \$mgr \$\\"(\$mgr)-install\\") {
    return
  }

  let cmd = packElevate \$mgr

  packRefreshForOp \$mgr

  match \$env.PACK_OP {
    add => {
      packOpAdd [\$\\"(\$cmd)-install\\"]
    }
    info => {
      packOpInfo [\$\\"(\$cmd)-query\\" --repository --show]
    }
    list => {
      packOpList (packListCmd \$mgr)
    }
    outdated => {
      packOpOutdated [\$\\"(\$cmd)-install\\" --dry-run --update]
    }
    remove => {
      packOpRemove [\$\\"(\$cmd)-remove\\" --recursive]
    }
    sync => {
      packOpSync [\$\\"(\$cmd)-install\\" --update] [\$\\"(\$cmd)-install\\" --update]
    }
    tidy => {
      packOp [\$\\"(\$cmd)-remove\\" --clean-cache --clean-cache]
      packOp [\$\\"(\$cmd)-remove\\" --remove-orphans]
    }
  }
}


def --env packZypper [] {
  let mgr = 'zypper'
  if (packSkip \$mgr) {
    return
  }

  let cmd = packElevate \$mgr

  packRefreshForOp \$mgr

  match \$env.PACK_OP {
    add => {
      packOpAdd [\$cmd install]
    }
    info => {
      packOpInfo [\$cmd info]
    }
    list => {
      packOpList (packListCmd \$mgr)
    }
    outdated => {
      packOpOutdated [\$cmd list-updates]
    }
    remove => {
      # same reason as list, above: search --installed-only isn't reliable
      packOpRemove [\$cmd uninstall]
    }
    sync => {
      packOpSync [\$cmd update] [\$cmd install]
    }
    tidy => {
      packOp [\$cmd clean --all]
      for flag in ['--unneeded', '--orphaned'] {
        let pkgs = (run-external 'zypper' 'packages' \$flag
          | lines
          | where { |l| (\$l | str trim | str starts-with 'i') }
          | each { |l| \$l | split row '|' | get 2 | str trim }
          | where { |n| (\$n | is-not-empty) })
        if (\$pkgs | is-not-empty) {
          packOp ([\$cmd remove --clean-deps] ++ \$pkgs)
        }
      }
    }
  }
}


# a bare name is nixpkgs' attribute of that name, which is what profile add and eval take; profile list, remove and
# upgrade name an element by its attribute alone
def packNixInstallable [raw: string] {
  \$raw | split row ' ' | each { |w|
    if (\$w | is-empty) or (\$w | str starts-with '-') or (\$w | str contains '#') { \$w } else { \$\\"nixpkgs#(\$w)\\" }
  } | str join ' '
}

def packNixHas [name: string] {
  let listed = (do { ^nix profile list --json } | complete)
  if \$listed.exit_code != 0 {
    return false
  }
  (\$name | split row '#' | last) in (\$listed.stdout | from json | get elements | columns)
}

def packNixOutdated [] {
  let listed = (do { ^nix profile list --json } | complete)
  if \$listed.exit_code != 0 {
    return []
  }
  \$listed.stdout | from json | get elements | transpose name element
    | where { |r| \$r.element.originalUrl? | is-not-empty }
    | each { |r|
      let target = \$\\"(\$r.element.originalUrl)#(\$r.element.attrPath).outPath\\"
      let res = (do { ^nix eval --raw \$target } | complete)
      if \$res.exit_code != 0 {
        opPrintWarn \$\\"nix eval (\$target) failed: (\$res.stderr | str trim | lines | last 1 | str join)\\"
        return null
      }
      if \$res.stdout in \$r.element.storePaths {
        return null
      }
      let named = { |p| \$p | path basename | str replace --regex '^[0-9a-z]{32}-' '' }
      {name: \$r.name, from: (do \$named (\$r.element.storePaths | first)), to: (do \$named \$res.stdout)}
    }
    | compact
}

def --env packNix [] {
  let mgr = 'nix'
  if (packSkip \$mgr) {
    return
  }

  # a profile is the user's own, so nothing here takes sudo
  match \$env.PACK_OP {
    add => {
      load-env {PACK_ADD_NAMES: (packNameList 'PACK_ADD_NAMES' | each { |n| packNixInstallable \$n })}
      packOpAdd [\$mgr profile add]
    }
    info => {
      for term in (packInfoNames) {
        packDo [\$mgr search (packNixInstallable \$term) '^']
      }
    }
    list => {
      packOpList (packListCmd \$mgr)
    }
    outdated => {
      let terms = (packNameList 'PACK_OUTDATED_NAMES')
      for o in (packNixOutdated) {
        if (\$terms | is-empty) or (\$terms | any { |t| wutWordMatch \$o.name \$t }) {
          opPrint (if \$o.from == \$o.to { \$\\"(\$o.name) (\$o.from) rebuilt\\" } else { \$\\"(\$o.name) (\$o.from) -> (\$o.to)\\" })
        }
      }
    }
    remove => {
      packOpRemove [\$mgr profile remove]
    }
    sync => {
      packOpSync [\$mgr profile upgrade --all] [\$mgr profile upgrade]
    }
    tidy => {
      packOp [\$mgr profile wipe-history]
      packOp [\$mgr store gc]
    }
  }
}


