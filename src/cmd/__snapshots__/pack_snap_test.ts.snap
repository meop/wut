\$env.PACK_PLAN = r#'[{\\"group\\":\\"lang-rustup\\",\\"name\\":\\"rustup\\",\\"paths\\":[{\\"id\\":\\"lang-rustup|brew\\",\\"manager\\":\\"brew\\",\\"names\\":[\\"rustup\\"]},{\\"id\\":\\"lang-rustup|apt\\",\\"manager\\":\\"apt\\",\\"names\\":[\\"rustup\\"]},{\\"id\\":\\"lang-rustup|dnf\\",\\"manager\\":\\"dnf\\",\\"names\\":[\\"rustup\\"]},{\\"id\\":\\"lang-rustup|pacman\\",\\"manager\\":\\"pacman\\",\\"names\\":[\\"rustup\\"]},{\\"id\\":\\"lang-rustup|xbps\\",\\"manager\\":\\"xbps\\",\\"names\\":[\\"rustup\\"]},{\\"id\\":\\"lang-rustup|winget\\",\\"manager\\":\\"winget\\",\\"names\\":[\\"rustlang.rustup\\"]}]}]'#

\$env.PACK_ADD_NAMES = [  ]

packPlanRun
