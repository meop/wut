    }
    outdated => {
      packOpOutdated [\$cmd outdated]
    }
    remove => {
      packOpRemove [\$cmd uninstall]
    }
    sync => {
      packOpSync [\$cmd upgrade --greedy] [\$cmd upgrade --greedy]
    }
    tidy => {
      packOp [\$cmd cleanup --prune=all --scrub]
      packOp [\$cmd autoremove]
    }
