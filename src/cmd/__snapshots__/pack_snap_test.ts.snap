    r#'shell-nu|cargo'# => {
\$env.PACK_MANAGER = r#'cargo'#
\$env.PACK_ADD_NAMES = [ r#'nu'# ]
packCargo
hide-env PACK_MANAGER
    }
    r#'shell-nu|brew'# => {
\$env.PACK_MANAGER = r#'brew'#
\$env.PACK_ADD_NAMES = [ r#'nushell'# ]
packBrew
hide-env PACK_MANAGER
    }
    r#'shell-nu|pacman'# => {
\$env.PACK_MANAGER = r#'pacman'#
\$env.PACK_ADD_NAMES = [ r#'nushell'# ]
packPacman
hide-env PACK_MANAGER
    }
    r#'shell-nu|xbps'# => {
\$env.PACK_MANAGER = r#'xbps'#
\$env.PACK_ADD_NAMES = [ r#'nushell'# ]
packXbps
hide-env PACK_MANAGER
    }
    r#'shell-nu|winget'# => {
\$env.PACK_MANAGER = r#'winget'#
\$env.PACK_ADD_NAMES = [ r#'nushell.nushell'# ]
packWinget
hide-env PACK_MANAGER
    }
    _ => {}
  }
}

\$env.PACK_PLAN = r#'[{\\"group\\":\\"shell-nu\\",\\"name\\":\\"nushell\\",\\"paths\\":[{\\"id\\":\\"shell-nu|ghpm\\",\\"manager\\":\\"ghpm\\",\\"names\\":[\\"nu\\"]},{\\"id\\":\\"shell-nu|cargo\\",\\"manager\\":\\"cargo\\",\\"names\\":[\\"nu\\"]},{\\"id\\":\\"shell-nu|brew\\",\\"manager\\":\\"brew\\",\\"names\\":[\\"nushell\\"]},{\\"id\\":\\"shell-nu|pacman\\",\\"manager\\":\\"pacman\\",\\"names\\":[\\"nushell\\"]},{\\"id\\":\\"shell-nu|xbps\\",\\"manager\\":\\"xbps\\",\\"names\\":[\\"nushell\\"]},{\\"id\\":\\"shell-nu|winget\\",\\"manager\\":\\"winget\\",\\"names\\":[\\"nushell.nushell\\"]}]}]'#

