    }
    outdated => {
      packOpOutdated [\$cmd outdated]
    }
    remove => {
      packOpRemove [\$cmd uninstall]
    }
    sync => {
      packOpSync [\$cmd upgrade all] [\$cmd upgrade]
    }
    tidy => {
