export const snapshot = {};

snapshot[`nu / alpine / add 1`] = `
\`^(\$env.WUT_HOME | path join 'bin' 'nu') --no-config-file -c r##'\$env.REQ_URL_SH = r#'http://x/sh/nu/pack/add/firefox?sysOsPlat=linux&sysOs=alpine&wutNuPinned=1'#

^(\$nu.current-exe) --no-config-file -c \$"( http get --raw --redirect-mode follow \$env.REQ_URL_SH )"

'##\`
`;

