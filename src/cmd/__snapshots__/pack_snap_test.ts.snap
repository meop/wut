    }
    r#'shell/zsh|pacman'# => {
\$env.PACK_MANAGER = r#'pacman'#
\$env.PACK_ADD_NAMES = [ r#'zsh'#, r#'zsh-completions'# ]
packPacman
hide-env PACK_MANAGER
    }
    r#'shell/zsh|apt'# => {
\$env.PACK_MANAGER = r#'apt'#
\$env.PACK_ADD_NAMES = [ r#'zsh'# ]
