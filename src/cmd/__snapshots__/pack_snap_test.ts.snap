    r#'shell-nu|cargo'# => {
\$env.PACK_MANAGER = r#'cargo'#
\$env.PACK_ADD_NAMES = [ r#'nu'# ]
packCargo
hide-env PACK_MANAGER
    }
    r#'shell-nu|brew'# => {
\$env.PACK_MANAGER = r#'brew'#
\$env.PACK_ADD_NAMES = [ r#'nushell'# ]
packBrew
hide-env PACK_MANAGER
    }
    r#'shell-nu|pacman'# => {
\$env.PACK_MANAGER = r#'pacman'#
\$env.PACK_ADD_NAMES = [ r#'nushell'# ]
packPacman
hide-env PACK_MANAGER
    }
    r#'shell-nu|xbps'# => {
\$env.PACK_MANAGER = r#'xbps'#
\$env.PACK_ADD_NAMES = [ r#'nushell'# ]
packXbps
hide-env PACK_MANAGER
    }
    r#'shell-nu|winget'# => {
\$env.PACK_MANAGER = r#'winget'#
\$env.PACK_ADD_NAMES = [ r#'nushell.nushell'# ]
packWinget
hide-env PACK_MANAGER
    }
    _ => {}
  }
}

