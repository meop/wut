    }
    outdated => {
      packOpOutdated [\$\\"(\$cmd)-install\\" --dry-run --update]
    }
    remove => {
      packOpRemove [\$\\"(\$cmd)-remove\\" --recursive]
    }
    sync => {
      packOpSync [\$\\"(\$cmd)-install\\" --update] [\$\\"(\$cmd)-install\\" --update]
    }
    tidy => {
      packOp [\$\\"(\$cmd)-remove\\" --clean-cache --clean-cache]
      packOp [\$\\"(\$cmd)-remove\\" --remove-orphans]
