    }
    find => {
      packOp [\$\\"(\$cmd)-install\\" --sync]
      packOpFind [\$\\"(\$cmd)-query\\" --repository --search]
    }
    info => {
      packOp [\$\\"(\$cmd)-install\\" --sync]
      packOpInfo [\$\\"(\$cmd)-query\\" --repository --show]
    }
    list => {
      packOpList [\$\\"(\$cmd)-query\\" --list-pkgs]
    }
    outdated => {
      packOp [\$\\"(\$cmd)-install\\" --sync]
      packOpOutdated [\$\\"(\$cmd)-install\\" --dry-run --update]
    }
    remove => {
