def --env packScoop [] {
  let bin = 'scoop'
  let cmd = (packScoopCmd)
  if (packSkip \$bin) {
    return
  }


  packRefreshForOp \$bin

  match \$env.PACK_OP {
    add => {
      packOpAdd (\$cmd ++ [install])
    }
    info => {
      packOpInfo (\$cmd ++ [info])
    }
    list => {
      packOpList (packListCmd 'scoop')
    }
    outdated => {
      packOpOutdated (\$cmd ++ [status])
    }
    remove => {
      packOpRemove (\$cmd ++ [uninstall --purge])
    }
    sync => {
      packOpSync (\$cmd ++ [update --all]) (\$cmd ++ [update])
    }
    tidy => {
      packOp (\$cmd ++ [cache rm --all])
      packOp (\$cmd ++ [cleanup --all])
    }
  }
}


\$env.PACK_MANAGERS = [ r#'ghpm'#, r#'cargo'#, r#'deno'#, r#'bun'#, r#'pnpm'#, r#'uv'#, r#'brew'#, r#'paru'#, r#'yay'#, r#'pacman'#, r#'apk'#, r#'apt'#, r#'dnf'#, r#'xbps'#, r#'zypper'#, r#'winget'#, r#'choco'#, r#'scoop'# ]

def --env packRunUnit [id: string] {
  match \$id {
    r#'lang-rustup|script'# => {
if 'NOOP' not-in \$env { zsh --no-rcs -c r#'curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs '|' sh'# }
    }
    r#'lang-rustup|pacman'# => {
\$env.PACK_MANAGER = r#'pacman'#
\$env.PACK_ADD_NAMES = [ r#'rustup'# ]
packPacman
hide-env PACK_MANAGER
    }
    r#'lang-rustup|apt'# => {
\$env.PACK_MANAGER = r#'apt'#
\$env.PACK_ADD_NAMES = [ r#'rustup'# ]
packApt
hide-env PACK_MANAGER
    }
    r#'lang-rustup|dnf'# => {
\$env.PACK_MANAGER = r#'dnf'#
\$env.PACK_ADD_NAMES = [ r#'rustup'# ]
packDnf
hide-env PACK_MANAGER
    }
    r#'lang-rustup|xbps'# => {
\$env.PACK_MANAGER = r#'xbps'#
\$env.PACK_ADD_NAMES = [ r#'rustup'# ]
packXbps
hide-env PACK_MANAGER
    }
    r#'lang-rustup|winget'# => {
\$env.PACK_MANAGER = r#'winget'#
\$env.PACK_ADD_NAMES = [ r#'rustlang.rustup'# ]
packWinget
hide-env PACK_MANAGER
    }
    _ => {}
  }
}

\$env.PACK_PLAN = r#'[{\\"group\\":\\"lang-rustup\\",\\"name\\":\\"rustup\\",\\"paths\\":[{\\"id\\":\\"lang-rustup|script\\",\\"manager\\":\\"script\\",\\"names\\":[\\"curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs '|' sh\\"]},{\\"id\\":\\"lang-rustup|pacman\\",\\"manager\\":\\"pacman\\",\\"names\\":[\\"rustup\\"]},{\\"id\\":\\"lang-rustup|apt\\",\\"manager\\":\\"apt\\",\\"names\\":[\\"rustup\\"]},{\\"id\\":\\"lang-rustup|dnf\\",\\"manager\\":\\"dnf\\",\\"names\\":[\\"rustup\\"]},{\\"id\\":\\"lang-rustup|xbps\\",\\"manager\\":\\"xbps\\",\\"names\\":[\\"rustup\\"]},{\\"id\\":\\"lang-rustup|winget\\",\\"manager\\":\\"winget\\",\\"names\\":[\\"rustlang.rustup\\"]}]}]'#

\$env.PACK_ADD_NAMES = [  ]

packPlanRun

} catch { |e|
  let shireSettled = (try { do { }; false } catch { true })
