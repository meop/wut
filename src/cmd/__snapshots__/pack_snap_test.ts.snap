    }
    remove => {
      packOpRemove 'apk' \$\\"use apk \\\\(system\\\\)\\" { |n| packGrepList [\$cmd list --installed] \$n } [\$cmd del]
    }
    sync => {
      packOp [\$cmd update]
      packOpSync [\$cmd upgrade] [\$cmd add]
    }
    tidy => {
      packOp [\$cmd cache clean]
    }
  }
}


