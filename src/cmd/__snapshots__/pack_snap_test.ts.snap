      packOpInfo [\$cmd info]
    }
    list => {
      packOpList (packListCmd \$mgr)
    }
    outdated => {
      packOpOutdated [\$cmd list -u]
    }
    remove => {
      packOpRemove [\$cmd del]
    }
    sync => {
      packOpSync [\$cmd upgrade] [\$cmd add]
    }
    tidy => {
      packOp [\$cmd cache clean]
    }
  }
}


