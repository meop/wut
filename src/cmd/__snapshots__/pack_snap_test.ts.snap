  if (\$env.PACK_OP not-in ['add', 'remove']) and not (packPrompt \$\\"use (\$cmd) \\\\(user\\\\)\\") { return }

  match \$env.PACK_OP {
    add => {
      packOp [\$cmd update]
      packOpAdd 'brew' \$\\"use brew \\\\(user\\\\)\\" { |n| packGrepFind [\$cmd search] \$n } [\$cmd install]
    }
    find => {
      packOp [\$cmd update]
      packOpFind [\$cmd search]
    }
    info => {
