  if (\$env.PACK_OP not-in ['add', 'remove']) and not (packPrompt \$\\"use (\$cmd) \\\\(system\\\\)\\") { return }
  let cmd = packElevate \$cmd

  match \$env.PACK_OP {
    add => {
      packOp [\$cmd makecache]
      packOpAdd 'dnf' \$\\"use dnf \\\\(system\\\\)\\" { |n| packGrepFind [\$cmd search] \$n } [\$cmd install]
    }
