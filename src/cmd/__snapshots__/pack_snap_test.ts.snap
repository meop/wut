\$env.PACK_PLAN = r#'[{\\"group\\":\\"shell-nu\\",\\"name\\":\\"shell\\",\\"paths\\":[{\\"id\\":\\"shell-nu|ghpm\\",\\"manager\\":\\"ghpm\\",\\"names\\":[\\"nu\\"]},{\\"id\\":\\"shell-nu|cargo\\",\\"manager\\":\\"cargo\\",\\"names\\":[\\"nu\\"]},{\\"id\\":\\"shell-nu|brew\\",\\"manager\\":\\"brew\\",\\"names\\":[\\"nushell\\"]},{\\"id\\":\\"shell-nu|pacman\\",\\"manager\\":\\"pacman\\",\\"names\\":[\\"nushell\\"]},{\\"id\\":\\"shell-nu|xbps\\",\\"manager\\":\\"xbps\\",\\"names\\":[\\"nushell\\"]},{\\"id\\":\\"shell-nu|winget\\",\\"manager\\":\\"winget\\",\\"names\\":[\\"nushell.nushell\\"]}]},{\\"group\\":\\"shell-zsh\\",\\"name\\":\\"shell\\",\\"paths\\":[{\\"id\\":\\"shell-zsh|ghpm\\",\\"manager\\":\\"ghpm\\",\\"names\\":[\\"zsh\\"]},{\\"id\\":\\"shell-zsh|cargo\\",\\"manager\\":\\"cargo\\",\\"names\\":[\\"zsh\\"]},{\\"id\\":\\"shell-zsh|brew\\",\\"manager\\":\\"brew\\",\\"names\\":[\\"zsh\\"]},{\\"id\\":\\"shell-zsh|pacman\\",\\"manager\\":\\"pacman\\",\\"names\\":[\\"zsh\\"]},{\\"id\\":\\"shell-zsh|xbps\\",\\"manager\\":\\"xbps\\",\\"names\\":[\\"zsh\\"]},{\\"id\\":\\"shell-zsh|winget\\",\\"manager\\":\\"winget\\",\\"names\\":[\\"zsh\\"]}]}]'#

