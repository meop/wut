\`"\${WUT_HOME}/vendor/nu" --no-config-file -c '\$env.REQ_URL_SH = r#'\\\\''http://x/sh/nu/script/exec/setup/docker?sysOsPlat=linux&wutNuPinned=1'\\\\''#

