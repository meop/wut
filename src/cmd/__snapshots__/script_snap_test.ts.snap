    opRunCmd "\$@"
  fi
}

function opMaybeRunSilentCmd {
  if [[ -z \$NOOP ]]; then
    opRunSilentCmd "\$@"
  fi
}

function opPrintRunCmd {
  opPrintCmd "\$@"
  opRunCmd "\$@"
}

function opPrintMaybeRunCmd {
  opPrintCmd "\$@"
  opMaybeRunCmd "\$@"
}


