\$env.REQ_URL_CFG = r#'http://x/cfg'#

\$env.REQ_URL_SH = r#'http://x/sh/nu/file/find/nu?sysOsPlat=linux&wutNuPinned=1'#

def opPrint --wrapped [...args] {
