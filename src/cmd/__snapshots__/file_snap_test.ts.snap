    exit 130
  }
  \$e.raw
}"
`;

snapshot[`nu / linux / sync (pinned, permissions) 1`] = `
"try {
try {
\$env.REQ_URL_CFG = r#'http://x/cfg'#

\$env.REQ_URL_SH = r#'http://x/sh/nu/file/sync/ssh?sysOsPlat=linux&wutNuPinned=1'#

def opPrint --wrapped [...args] {
  \$\\"(\$args | flatten | str join ' ')\\" | print
}

def opPrintErr --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print --stderr
    return
  }
  \$\\"(ansi red)(\$args | flatten | str join ' ')(ansi reset)\\" | print --stderr
}

def opPrintSucc --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print
    return
  }
  \$\\"(ansi green)(\$args | flatten | str join ' ')(ansi reset)\\" | print
}

def opPrintWarn --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print
    return
  }
  \$\\"(ansi yellow)(\$args | flatten | str join ' ')(ansi reset)\\" | print
}

def opPrintInfo --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print
    return
  }
  \$\\"(ansi blue)(\$args | flatten | str join ' ')(ansi reset)\\" | print
}

def opPrintVerbose --wrapped [...args] {
  if VERBOSE not-in \$env {
    return
  }
  \$\\"(\$args | flatten | str join ' ')\\" | print --stderr
}

def opPrintCmd --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print
    return
  }
  let args = \$args | flatten
  \$\\"(ansi magenta)(\$args | first)(ansi reset)\\" | print --no-newline
  if (\$args | length) > 1 {
    \$\\" (ansi cyan)(\$args | skip 1 | str join ' ')(ansi reset)\\" | print
  } else {
    print ''
  }
}

def opMaybePrintCmd --wrapped [...args] {
  if DRYRUN not-in \$env {
    opPrintCmd ...\$args
  }
}

# a ctrl-c: nu's own, an input prompt's, or the exit of a command it stopped (130, SIGINT, windows' ctrl-c status)
def opInterrupted [e: record] {
  (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510])
}

# a catch hands its error here first, so a ctrl-c is not stepped past
def opRethrowInterrupt [e: record] {
  if (opInterrupted \$e) {
    \$e.raw
  }
}

# NuSh.quietInterrupt, line for line, for the child nu a command runs in
def opQuietInterrupt [body: string] {
  let stop = [
    r#'if (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {'#
    r#'  exit 130'#
    r#'}'#
    r#'\$e.raw'#
  ] | each { |l| \$\\"  (\$l)\\" }
  [r#'try {'# r#'try {'# \$body r#'} catch { |e|'# ...\$stop r#'}'# r#'} catch { |e|'# ...\$stop r#'}'#] | str join \\"\\\\n\\"
}

def opRunCmd --wrapped [...args] {
  ^(\$nu.current-exe) --no-config-file -c (opQuietInterrupt \$\\"(\$args | flatten | str join ' ')\\")
}

def opRunSilentCmd --wrapped [...args] {
  ^(\$nu.current-exe) --no-config-file -c (opQuietInterrupt \$\\"(\$args | flatten | str join ' ') o+e> | silent\\")
}

# a yes/no question: empty, y or yes is yes, and YES answers yes without asking. with no terminal to answer from,
# as under cron or a pipe, it is no: input would fail there with an i/o error
def opAsk [question: string] {
  if 'YES' in \$env {
    return true
  }
  if not (is-terminal --stdin) {
    opPrintWarn \$\\"(\$question): no terminal to answer from, so no; YES answers yes\\"
    return false
  }
  # a question starts a step of its own: one blank line before it, and what it lets through right below the answer
  opPrint ''
  let yn = (input \$\\"(\$question) [[y]/n]: \\" | str lowercase)
  \$yn in ['' 'y' 'yes']
}

def opMaybeRunCmd --wrapped [...args] {
  if DRYRUN not-in \$env {
    opRunCmd ...\$args
  }
}

def opMaybeRunSilentCmd --wrapped [...args] {
  if DRYRUN not-in \$env {
    opRunSilentCmd ...\$args
  }
}

def opPrintRunCmd --wrapped [...args] {
  opPrintCmd ...\$args
  opRunCmd ...\$args
}

def opPrintMaybeRunCmd --wrapped [...args] {
  opPrintCmd ...\$args
  opMaybeRunCmd ...\$args
}


\$env.SH_VERS_MAJOR = 0

\$env.SH_VERS_MINOR = 116

do {
  let major = \$env.SH_VERS_MAJOR | into int
  let minor = \$env.SH_VERS_MINOR | into int

  if ((version | get major) < \$major) or ((version | get minor) < \$minor) {
    opPrintErr \$\\"nu must be >= '(\$major).(\$minor)' .. found '(version | get version)' .. aborting\\"
    exit 1
  }
}


\$env.NU_VERS_MAJOR = 0

\$env.NU_VERS_MINOR = 116

\$env.NU_VERS_PATCH = 0

\$env.REQ_ORIG = r#'http://x'#

\$env.SYS_OS_PLAT = r#'linux'#

\$env.REQ_PATH = r#'/sh/nu/file/sync/ssh'#

\$env.REQ_SRCH = r#'?sysOsPlat=linux&wutNuPinned=1'#

def wutNuVersCurrent [nu_bin: string, nu_vers: string] {
  if not (\$nu_bin | path exists) {
    return false
  }
  let installed = (do { ^\$nu_bin --version } | complete)
  if \$installed.exit_code != 0 {
    return false
  }
  (\$installed.stdout | str trim) == \$nu_vers
}

def wutNuLockRelease [lock_path: string] {
  rm --force \$lock_path
  # best-effort: only succeeds if now empty, so a concurrent process's own in-flight files are never touched
  try { rm (\$lock_path | path dirname) } catch { |e| opRethrowInterrupt \$e }
}

def wutNuInstall [wut_home: string, nu_bin: string, nu_vers: string, ext: string] {
  if (wutNuVersCurrent \$nu_bin \$nu_vers) {
    opPrintVerbose \$\\"nu (\$nu_vers): current at (\$nu_bin)\\"
    return
  }
  let found = if (\$nu_bin | path exists) { (do { ^\$nu_bin --version } | complete).stdout | str trim } else { '' }
  opPrintVerbose \$\\"nu (\$nu_vers): (\$nu_bin) has (if (\$found | is-empty) { 'none' } else { \$found }), syncing\\"

  let triple = match \$\\"(\$env.SYS_OS_PLAT)_(\$env.SYS_CPU_ARCH)\\" {
    'darwin_aarch64' => 'aarch64-apple-darwin',
    'darwin_x86_64' => 'x86_64-apple-darwin',
    'linux_aarch64' => 'aarch64-unknown-linux-gnu',
    'linux_x86_64' => 'x86_64-unknown-linux-gnu',
    'windows_aarch64' => 'aarch64-pc-windows-msvc',
    'windows_x86_64' => 'x86_64-pc-windows-msvc',
    _ => '',
  }
  let gnu_loader = if \$env.SYS_CPU_ARCH == 'aarch64' { '/lib/ld-linux-aarch64.so.1' } else { '/lib64/ld-linux-x86-64.so.2' }
  let musl = (\$triple | str ends-with '-gnu') and ((glob '/lib/ld-musl-*.so.1' | is-not-empty) or not (\$gnu_loader | path exists))
  let triple = if \$musl { \$triple | str replace --regex '-gnu\$' '-musl' } else { \$triple }
  if \$triple == '' {
    opPrintErr \$\\"unsupported platform/arch for nu sync: (\$env.SYS_OS_PLAT)/(\$env.SYS_CPU_ARCH)\\"
    exit 1
  }

  # a hidden dir nested inside vendor (not vendor itself) so a fresh download can never collide with the pinned nu_bin path
  let work_dir = (\$wut_home | path join 'vendor' '.nu')
  mkdir \$work_dir

  let lock_path = (\$work_dir | path join 'nu.lock')
  mut acquired = false
  mut waited = 0
  while \$waited < 240 {
    if (wutNuVersCurrent \$nu_bin \$nu_vers) {
      return
    }
    let locked = (try { \\"\\" | save \$lock_path; true } catch { |e| opRethrowInterrupt \$e; false })
    if \$locked {
      \$acquired = true
      break
    }
    if \$waited == 0 {
      opPrintVerbose \$\\"nu (\$nu_vers): waiting on another sync's lock (\$lock_path)\\"
    }
    sleep 500ms
    \$waited = \$waited + 1
  }
  if not \$acquired {
    opPrintWarn \$\\"reclaiming stale nu sync lock: (\$lock_path)\\"
    rm --force \$lock_path
    let locked = (try { \\"\\" | save \$lock_path; true } catch { |e| opRethrowInterrupt \$e; false })
    if not \$locked {
      opPrintErr \$\\"failed to acquire nu sync lock: (\$lock_path)\\"
      exit 1
    }
  }

  if (wutNuVersCurrent \$nu_bin \$nu_vers) {
    wutNuLockRelease \$lock_path
    return
  }

  let ext_archive = if \$env.SYS_OS_PLAT == 'windows' { 'zip' } else { 'tar.gz' }
  let asset = \$\\"nu-(\$nu_vers)-(\$triple).(\$ext_archive)\\"
  let url = \$\\"https://github.com/nushell/nushell/releases/download/(\$nu_vers)/(\$asset)\\"
  let archive_path = (\$work_dir | path join \$asset)
  let extract_dir = (\$work_dir | path join \$\\"nu-(\$nu_vers)-(\$triple)\\")

  rm --force --recursive \$archive_path \$extract_dir

  opPrintVerbose \$\\"nu (\$nu_vers): fetching (\$url)\\"
  let fetched = (do { ^curl --fail-with-body --location --no-progress-meter --output \$archive_path --url \$url } | complete)
  if \$fetched.exit_code != 0 {
    opPrintErr (\$fetched.stderr | str trim)
    opPrintErr \$\\"failed to download nu (\$nu_vers): (\$url)\\"
    rm --force \$archive_path
    wutNuLockRelease \$lock_path
    exit 1
  }

  let sums_url = \$\\"https://github.com/nushell/nushell/releases/download/(\$nu_vers)/SHA256SUMS\\"
  opPrintVerbose \$\\"nu (\$nu_vers): checking against (\$sums_url)\\"
  let sums = (do { ^curl --fail-with-body --location --no-progress-meter --url \$sums_url } | complete)
  let want = (\$sums.stdout | lines | split column --regex '\\\\s+' sum name | where name == \$asset | get -o 0.sum | default '')
  let got = (open --raw \$archive_path | hash sha256)
  if \$sums.exit_code != 0 or (\$want | is-empty) or \$got != \$want {
    opPrintErr \$\\"nu (\$nu_vers): (\$asset) does not match the release's SHA256SUMS\\"
    rm --force \$archive_path
    wutNuLockRelease \$lock_path
    exit 1
  }

  # zip assets (windows) have no wrapping folder, unlike tar.gz assets, so they must extract directly into
  # extract_dir; tar.gz assets already contain their own nu-(\$nu_vers)-(\$triple) folder, so they extract into work_dir
  let extract_target = if \$ext_archive == 'zip' {
    mkdir \$extract_dir
    \$extract_dir
  } else {
    \$work_dir
  }
  opPrintVerbose \$\\"nu (\$nu_vers): extracting into (\$extract_target)\\"
  let extracted = (do { ^tar -xf \$archive_path -C \$extract_target } | complete)
  if \$extracted.exit_code != 0 {
    opPrintErr (\$extracted.stderr | str trim)
    opPrintErr \$\\"failed to extract nu (\$nu_vers)\\"
    rm --force --recursive \$archive_path \$extract_dir
    wutNuLockRelease \$lock_path
    exit 1
  }

  let extracted_bin = (\$extract_dir | path join \$\\"nu(\$ext)\\")
  if not (\$extracted_bin | path exists) {
    opPrintErr \$\\"nu binary not found in extracted archive: (\$extract_dir)\\"
    rm --force --recursive \$archive_path \$extract_dir
    wutNuLockRelease \$lock_path
    exit 1
  }

  if \$env.SYS_OS_PLAT != 'windows' {
    ^chmod +x \$extracted_bin
  }
  mv --force \$extracted_bin \$nu_bin
  rm --force --recursive \$archive_path \$extract_dir
  opPrintVerbose \$\\"nu (\$nu_vers): installed at (\$nu_bin)\\"

  wutNuLockRelease \$lock_path
}

def --env wutNuSync [] {
  if \$env.SYS_OS_PLAT not-in ['darwin' 'linux' 'windows'] {
    opPrintWarn 'script is for darwin, linux, or windows'
    return
  }

  # windows has no HOME, and default's argument is evaluated even when WUT_HOME is set, so nu's own answer stands in,
  # as it does for the lock
  \$env.WUT_HOME = (\$env.WUT_HOME? | default (\$nu.home-dir | path join '.wut'))
  let wut_home = \$env.WUT_HOME
  let ext = if \$env.SYS_OS_PLAT == 'windows' { '.exe' } else { '' }
  let nu_bin = (\$wut_home | path join 'vendor' \$\\"nu(\$ext)\\")
  let nu_vers = \$\\"(\$env.NU_VERS_MAJOR).(\$env.NU_VERS_MINOR).(\$env.NU_VERS_PATCH)\\"

  wutNuInstall \$wut_home \$nu_bin \$nu_vers \$ext
}

wutNuSync

# pwsh's module dirs would otherwise leak into windows powershell (scoop)
if \$env.SYS_OS_PLAT == 'windows' {
  hide-env -i PSModulePath
}


# a tool this run installed, or one installed since the calling shell started, lands somewhere that shell's PATH may
# not reach yet. the env stage wut deploys already knows every such place, and adds each once it exists, so the run
# asks the native shell for the PATH a new one would start with, rather than leaving the next step to find nothing.
# windows keeps PATH in the registry too, where installers record theirs, so that joins what the profile builds
def --env wutPathRefresh [] {
  let out = if \$env.SYS_OS_PLAT? == 'windows' {
    if (which pwsh | is-empty) {
      return
    }
    let cmd = \\"\$sep = [IO.Path]::PathSeparator; \$reg = @('Machine', 'User') | ForEach-Object { [Environment]::GetEnvironmentVariable('Path', \$_) }; (((\$env:PATH -split \$sep) + (\$reg -split \$sep)) | Where-Object { \$_ } | Select-Object -Unique) -join \$sep\\"
    ^pwsh -NoLogo -Command \$cmd | complete
  } else {
    if (which zsh | is-empty) {
      return
    }
    ^zsh -c 'print -r -- \$PATH' | complete
  }
  # the last line, since an env stage is free to print on its way through
  let path = (\$out.stdout | lines | where { is-not-empty } | last 1 | get -o 0)
  if \$out.exit_code != 0 or \$path == null {
    return
  }
  \$env.PATH = (\$path | split row (char esep) | where { is-not-empty } | uniq)
}


wutPathRefresh

\$env.FILE_SYNC_PARTS = r#'ssh'#

# ghpm's table: a rule as wide as each header, columns padded to their widest cell, the last one loose. a column no
# row fills says nothing, so it is left out: a plan of only loose names has no group to show
def wutTable [headers: list<string>, rows: list<list<string>>] {
  let keep = (\$headers | enumerate | where { |h|
    (\$rows | is-empty) or (\$rows | any { |r| \$r | get -o \$h.index | default '' | is-not-empty })
  } | get index)
  let headers = (\$keep | each { |i| \$headers | get \$i })
  let rows = (\$rows | each { |r| \$keep | each { |i| \$r | get -o \$i | default '' } })
  let widths = (\$headers | enumerate | each { |h|
    [(\$h.item | str length)] ++ (\$rows | each { |r| \$r | get -o \$h.index | default '' | str length }) | math max
  })
  let line = { |cells: list<string>|
    \$cells | enumerate | each { |c|
      if \$c.index == ((\$cells | length) - 1) { \$c.item } else { \$c.item | fill --alignment left --width (\$widths | get \$c.index) }
    } | str join ' ' | str trim --right
  }
  opPrint (do \$line \$headers)
  opPrint (do \$line (\$headers | each { |h| '-' | fill --alignment left --width (\$h | str length) --character '-' }))
  for r in \$rows { opPrint (do \$line \$r) }
}

def wutSelectParse [choice: string, max: int] {
  let trimmed = (\$choice | str trim)
  if (\$trimmed | is-empty) {
    return (1..\$max | each { |i| \$i })
  }
  mut picked = []
  for part in (\$trimmed | split row --regex '[, ]+' | where { |p| \$p | is-not-empty }) {
    let bounds = if (\$part | str contains '-') {
      let halves = (\$part | split row '-')
      if (\$halves | length) != 2 {
        return null
      }
      [(try { \$halves | get 0 | into int } catch { |e| opRethrowInterrupt \$e; null }), (try { \$halves | get 1 | into int } catch { |e| opRethrowInterrupt \$e; null })]
    } else {
      let n = (try { \$part | into int } catch { |e| opRethrowInterrupt \$e; null })
      if \$n == 0 {
        return null
      }
      [\$n, \$n]
    }
    let from = (\$bounds | get 0)
    let to = (\$bounds | get 1)
    if \$from == null or \$to == null or \$from < 1 or \$to > \$max or \$from > \$to {
      return null
    }
    for i in \$from..\$to {
      if \$i not-in \$picked {
        \$picked = (\$picked | append \$i)
      }
    }
  }
  \$picked | sort
}

def wutSelectRead [max: int] {
  # -y answers the question, it does not skip the step: what was picked runs after a blank, as it does under the question
  if YES in \$env {
    opPrint ''
    return (1..\$max | each { |i| \$i })
  }
  # with no terminal to choose from, as under cron or a pipe, nothing is picked, the way a question there is no
  if not (is-terminal --stdin) {
    opPrintWarn 'no terminal to choose from, so none; -y picks all'
    return null
  }
  opPrint ''
  wutSelectParse (input \$\\"enter number\\\\(s\\\\) [empty=all] \\\\(0=quit | 1[,][-](\$max)\\\\): \\") \$max
}


# one lock for the whole machine, held by whatever is about to change it; see docs/OPS.md (One host lock)

def wutLockPath [] {
  \$env.WUT_HOME? | default (\$nu.home-dir | path join '.wut') | path join 'lock' 'host'
}

# a pid and when it started, so a pid handed on to another process since is not taken for the holder
def wutLockStamp [pid: int] {
  let found = (ps --long | where pid == \$pid)
  if (\$found | is-empty) {
    return ''
  }
  let started = (\$found | first | get -o start_time)
  if \$started == null { \$\\"(\$pid)\\" } else { \$\\"(\$pid) (\$started | format date '%s')\\" }
}

def wutLockRead [dir: string, file: string] {
  try { open --raw (\$dir | path join \$file) | str trim } catch { |e| opRethrowInterrupt \$e; '' }
}

def wutLockHolderPid [held: string] {
  try { \$held | split row ' ' | first | into int } catch { |e| opRethrowInterrupt \$e; -1 }
}

# the os's own mkdir, which fails when the dir is already there; nu's is mkdir -p
def wutLockMake [dir: string] {
  let parent = (\$dir | path dirname)
  mkdir \$parent
  let made = if \$nu.os-info.name == 'windows' {
    do { cd \$parent; ^cmd /c mkdir (\$dir | path basename) } | complete
  } else {
    do { ^mkdir \$dir } | complete
  }
  \$made.exit_code == 0
}

# this process and every one it descends from
def wutLockLineage [] {
  let procs = (ps | select pid ppid)
  mut line = [\$nu.pid]
  mut at = \$nu.pid
  for _ in 1..64 {
    let up = (\$procs | where pid == \$at | get -o 0.ppid)
    if \$up == null or \$up <= 0 or \$up in \$line {
      break
    }
    \$line = (\$line | append \$up)
    \$at = \$up
  }
  \$line
}

# the lock is this run's when this process or one it descends from holds it: the stamp it hands down through
# WUT_LOCK_HOST, or failing that its pid in this one's lineage, since sudo, su and a service start a child without
# that environment
def wutLockMine [dir: string] {
  let held = (wutLockRead \$dir 'pid')
  let pid = (wutLockHolderPid \$held)
  if \$pid < 0 or (wutLockStamp \$pid) != \$held {
    return false
  }
  (\$env.WUT_LOCK_HOST? | default '') == \$held or \$pid in (wutLockLineage)
}

# where a run is about to change the machine: takes the host lock, waiting for whoever holds it, and says once who
# that is. outside a wutLockScope it does nothing, so a reading op that shares a runner with a changing one takes none
def --env wutLockHold [] {
  let what = (\$env.WUT_LOCK_SCOPE? | default '')
  if \$what == '' {
    return
  }
  let dir = (wutLockPath)
  if (wutLockMine \$dir) {
    return
  }
  let own = (wutLockStamp \$nu.pid)
  mut told = false
  loop {
    if (wutLockMake \$dir) {
      \$what | save --force (\$dir | path join 'what')
      \$own | save --force (\$dir | path join 'pid')
      load-env {WUT_LOCK_HOST: \$own}
      return
    }
    let held = (wutLockRead \$dir 'pid')
    if \$held == '' {
      let made = (try { ls --directory \$dir | first | get modified } catch { |e| opRethrowInterrupt \$e; date now })
      if ((date now) - \$made) < 5sec {
        sleep 100ms
        continue
      }
    } else {
      let pid = (wutLockHolderPid \$held)
      if \$pid >= 0 and (wutLockStamp \$pid) == \$held {
        if not \$told {
          opPrintInfo \$\\"waiting for \`wut (wutLockRead \$dir 'what')\` \\\\(pid (\$pid)\\\\) to finish changing this host\\"
          \$told = true
        }
        sleep 250ms
        continue
      }
    }
    if (wutLockRead \$dir 'pid') == \$held {
      rm --recursive --force \$dir
    }
  }
}

# a run that may change the machine runs inside this: what wutLockHold takes in it is given back when it ends,
# however it ends. what: the command a waiting run names, \`pack sync\`
def --env wutLockScope [what: string, work: closure] {
  let dir = (wutLockPath)
  let had = (wutLockMine \$dir)
  let outer = (\$env.WUT_LOCK_SCOPE? | default '')
  \$env.WUT_LOCK_SCOPE = (if \$outer == '' { \$what } else { \$outer })
  let release = {||
    if not \$had and (wutLockRead \$dir 'pid') == (wutLockStamp \$nu.pid) {
      rm --recursive --force \$dir
    }
  }
  try {
    do --env \$work
  } catch { |e|
    do \$release
    opRethrowInterrupt \$e
    \$e.raw
  }
  do \$release
  if \$outer == '' {
    hide-env -i WUT_LOCK_SCOPE
  }
}


def replaceEnv [line] {
  mut l = \$line
  if (\$l | str contains '{') {
    let itemsEnv = \$env | items { |key, value| [\$key, \$value] }
    for e in (\$itemsEnv | where { |e| ((\$e.0 | describe) == string) and ((\$e.1 | describe) == string) }) {
      \$l = \$l | str replace --all \$\\"{(\$e.0)}\\" (\$e.1)
    }
  }
  return \$l
}

# a tool's key is the bin to look for: a config for something not installed is skipped rather than written
def fileBinHere [tool: string] {
  which \$tool | is-not-empty
}

# one field of a plan entry, which is the key and then its parts, joined by |
def fileField [entry: string, i: int] {
  \$entry | split row '|' | get \$i
}

def fileDst [raw: string] {
  replaceEnv \$raw | path expand
}

def fileOf [entries: list, tool: string] {
  \$entries | where { |e| (fileField \$e 0) == \$tool }
}

# remove takes back what is on disk, whether or not the tool still is: a pack removes a tool's files before the tool
def fileToolHere [tool: string, pairs: list] {
  if \$env.FILE_OP? == 'remove' {
    fileOf \$pairs \$tool | any { |p| fileDst (fileField \$p 2) | path exists }
  } else {
    fileBinHere \$tool
  }
}

# the plan for the ops that act: which tools are here, each with the files it would write or remove, then a row per
# tool to pick. outdated fetches every source sync would, so it is gated the same
def filePlanShow [pairsKey: string, dirsKey: string, toolsKey: string] {
  let pairs = (\$env | get -o \$pairsKey | default [])
  let tools = (\$pairs | each { |p| fileField \$p 0 } | uniq | sort | where { |t| fileToolHere \$t \$pairs })
  if (\$tools | is-empty) {
    opPrintWarn (if \$env.FILE_OP == 'remove' { 'nothing to remove' } else { 'no tool here has files' })
    return false
  }
  for t in \$tools {
    opPrint \$t
    for p in (fileOf \$pairs \$t) {
      let dst = (fileDst (fileField \$p 2))
      if \$env.FILE_OP != 'remove' or (\$dst | path exists) {
        opPrint \$\\"  (\$dst)\\"
      }
    }
  }
  opPrint ''
  wutTable ['tool'] (\$tools | enumerate | each { |t| [\$\\"(\$t.index + 1)\\\\) (\$t.item)\\"] })
  let picked = (wutSelectRead (\$tools | length))
  if \$picked == null {
    return false
  }
  load-env {(\$toolsKey): (\$picked | each { |i| \$tools | get (\$i - 1) })}
  true
}

def fileFetch [src: string] {
  let srcUrl = \$\\"(\$env.REQ_URL_CFG)/file/(\$src | str trim --left --char '/')\\"
  opPrintCmd http get --raw --redirect-mode follow \$\\"r#'(\$srcUrl)'#\\"
  http get --raw --redirect-mode follow \$srcUrl
}

# what writing a source would do to its destination: nothing, a new file, or a changed one, by their bytes
def fileState [content, dst: string] {
  if not (\$dst | path exists) {
    'new'
  } else if (open --raw \$dst | hash sha256) == (\$content | hash sha256) {
    'same'
  } else {
    'changed'
  }
}

# files in a folder map's destination that its source no longer has: a sync takes them out, so the folder is the
# source's, without clearing and writing all of it again
def fileStray [tool: string, pairs: list, dirs: list] {
  let wanted = (fileOf \$pairs \$tool | each { |p| fileDst (fileField \$p 2) })
  fileOf \$dirs \$tool | each { |d| fileDst (fileField \$d 1) } | where { |d| \$d | path exists } | each { |d|
    # from inside the dir, so a windows path's separators are never read as a pattern's escapes
    do { cd \$d; glob '**/*' --no-dir } | where { |f| \$f not-in \$wanted }
  } | flatten
}

# what a sync of one tool would change, said and not done: each file it would write, with the diff of a changed one,
# and each it would take out
def fileOutdatedTool [tool: string, pairs: list, dirs: list] {
  mut pending = 0
  for p in (fileOf \$pairs \$tool) {
    let dst = (fileDst (fileField \$p 2))
    let content = (fileFetch (fileField \$p 1))
    let state = (fileState \$content \$dst)
    if \$state == 'same' {
      continue
    }
    \$pending += 1
    opPrint \$\\"  (\$state): (\$dst)\\"
    if \$state == 'changed' {
      let tmp = (mktemp --suffix '.file.outdated.tmp' --tmpdir)
      \$content | save --force --raw \$tmp
      let diffCmd = if (which diff | is-not-empty) { 'diff' } else { 'fc' }
      run-external \$diffCmd \$dst \$tmp | complete | get stdout | str trim --right | lines | each { |l| opPrint \$\\"    (\$l)\\" }
      rm --force \$tmp
    }
  }
  for f in (fileStray \$tool \$pairs \$dirs) {
    \$pending += 1
    opPrint \$\\"  stale: (\$f)\\"
  }
  if \$pending == 0 {
    opPrintInfo \$\\"(\$tool): up to date\\"
  }
}

# a sync of one tool writes only what differs from its source, takes out what its folder maps no longer have, and
# sets permissions where it wrote, so a sync that changes nothing writes nothing
def --env fileSyncTool [tool: string, pairs: list, dirs: list, perms: list] {
  mut wrote = false
  mut same = 0
  for p in (fileOf \$pairs \$tool) {
    let dst = (fileDst (fileField \$p 2))
    let content = (fileFetch (fileField \$p 1))
    let state = (fileState \$content \$dst)
    if \$state == 'same' {
      \$same += 1
      continue
    }
    let parent = (\$dst | path dirname)
    if not (\$parent | path exists) {
      opPrintMaybeRunCmd mkdir \$\\"r#'(\$parent)'#\\"
    }
    opPrintCmd save --force --raw \$\\"r#'(\$dst)'#\\"
    if 'DRYRUN' not-in \$env {
      \$content | save --force --raw \$dst
    }
    \$wrote = true
  }
  for f in (fileStray \$tool \$pairs \$dirs) {
    opPrintMaybeRunCmd rm --force --permanent \$\\"r#'(\$f)'#\\"
    \$wrote = true
  }
  if \$wrote {
    for perm in (fileOf \$perms \$tool) {
      opPrintMaybeRunCmd ...(replaceEnv (fileField \$perm 1) | split row ' ')
    }
  }
  if \$same > 0 {
    opPrintInfo \$\\"(\$tool): (\$same) unchanged\\"
  }
}

# a remove of one tool takes out every folder map's destination whole, and each file it wrote elsewhere
def --env fileRemoveTool [tool: string, pairs: list, dirs: list] {
  let dirPaths = (fileOf \$dirs \$tool | each { |d| fileDst (fileField \$d 1) })
  for d in (\$dirPaths | where { |d| \$d | path exists }) {
    opPrintMaybeRunCmd rm --force --permanent --recursive \$\\"r#'(\$d)'#\\"
  }
  for p in (fileOf \$pairs \$tool) {
    let dst = (fileDst (fileField \$p 2))
    if (\$dirPaths | any { |d| \$dst | str starts-with \$\\"(\$d)(char path_sep)\\" }) or not (\$dst | path exists) {
      continue
    }
    opPrintMaybeRunCmd rm --force --permanent \$\\"r#'(\$dst)'#\\"
  }
}

def fileToolChosen [toolsKey: string, tool: string] {
  let chosen = (\$env | get -o \$toolsKey | default [])
  (\$chosen | is-empty) or (\$tool in \$chosen)
}

def file [] {
  let op = \$env.FILE_OP
  let key = (\$op | str uppercase)
  let pairs = (\$env | get -o \$\\"FILE_(\$key)_PATH_PAIRS\\" | default [])
  let dirs = (\$env | get -o \$\\"FILE_(\$key)_DIRS\\" | default [])
  let perms = (\$env | get -o \$\\"FILE_(\$key)_PATH_PERMS\\" | default [])
  let tools = (\$pairs | each { |p| fileField \$p 0 } | uniq | sort | where { |t| fileToolChosen \$\\"FILE_(\$key)_TOOLS\\" \$t })
  match \$op {
    find => {
      let here = (
        (\$env.FILE_FIND_KEYS? | default []) | each { |entry| \$entry | split row '|' }
          | where { |parts| fileBinHere (\$parts | get 0) }
          | each { |parts| {
            bin: (\$parts | get 0),
            ins: (\$parts | get -o 1 | default ''),
          } }
      )
      for e in \$here {
        opPrint \$e.bin
        if (\$e.ins | is-not-empty) {
          opPrint \$\\"  (\$e.ins)\\"
        }
      }
    }
    list => {
      # what is in place on this machine: each file a tool here has, where it is
      for t in (\$tools | where { |t| fileBinHere \$t }) {
        let present = (fileOf \$pairs \$t | each { |p| fileDst (fileField \$p 2) } | where { |d| \$d | path exists })
        if (\$present | is-not-empty) {
          opPrint \$t
          for d in \$present {
            opPrint \$\\"  (\$d)\\"
          }
        }
      }
    }
    outdated => {
      for t in \$tools {
        opPrint \$t
        fileOutdatedTool \$t \$pairs \$dirs
      }
    }
    sync => {
      wutLockHold
      for t in \$tools {
        fileSyncTool \$t \$pairs \$dirs \$perms
      }
    }
    remove => {
      wutLockHold
      for t in \$tools {
        fileRemoveTool \$t \$pairs \$dirs
      }
    }
  }
}


\$env.FILE_SYNC_PATH_PAIRS = [ r#'ssh|ssh/config|{HOME}/.ssh/config'#, r#'ssh|ssh/hushlogin|{HOME}/.hushlogin'# ]

\$env.FILE_SYNC_DIRS = [  ]

\$env.FILE_SYNC_PATH_PERMS = [ r##'ssh|zsh --no-rcs -c r#'chmod -R a-s,u=rw,g=,o= '{HOME}/.ssh/config''#'## ]

\$env.FILE_OP = r#'sync'#

wutLockScope r#'file sync'# {
  if not (filePlanShow 'FILE_SYNC_PATH_PAIRS' 'FILE_SYNC_DIRS' 'FILE_SYNC_TOOLS') {
    return
  }
  file
}

} catch { |e|
  if (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {
    exit 130
  }
  \$e.raw
}
} catch { |e|
  if (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {
    exit 130
  }
  \$e.raw
}"
`;

snapshot[`nu / linux / outdated (pinned, filtered) 1`] = `
"try {
try {
\$env.REQ_URL_CFG = r#'http://x/cfg'#

\$env.REQ_URL_SH = r#'http://x/sh/nu/file/outdated/zsh?sysOsPlat=linux&wutNuPinned=1'#

def opPrint --wrapped [...args] {
  \$\\"(\$args | flatten | str join ' ')\\" | print
}

def opPrintErr --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print --stderr
    return
  }
  \$\\"(ansi red)(\$args | flatten | str join ' ')(ansi reset)\\" | print --stderr
}

def opPrintSucc --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print
    return
  }
  \$\\"(ansi green)(\$args | flatten | str join ' ')(ansi reset)\\" | print
}

def opPrintWarn --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print
    return
  }
  \$\\"(ansi yellow)(\$args | flatten | str join ' ')(ansi reset)\\" | print
}

def opPrintInfo --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print
    return
  }
  \$\\"(ansi blue)(\$args | flatten | str join ' ')(ansi reset)\\" | print
}

def opPrintVerbose --wrapped [...args] {
  if VERBOSE not-in \$env {
    return
  }
  \$\\"(\$args | flatten | str join ' ')\\" | print --stderr
}

def opPrintCmd --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print
    return
  }
  let args = \$args | flatten
  \$\\"(ansi magenta)(\$args | first)(ansi reset)\\" | print --no-newline
  if (\$args | length) > 1 {
    \$\\" (ansi cyan)(\$args | skip 1 | str join ' ')(ansi reset)\\" | print
  } else {
    print ''
  }
}

def opMaybePrintCmd --wrapped [...args] {
  if DRYRUN not-in \$env {
    opPrintCmd ...\$args
  }
}

# a ctrl-c: nu's own, an input prompt's, or the exit of a command it stopped (130, SIGINT, windows' ctrl-c status)
def opInterrupted [e: record] {
  (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510])
}

# a catch hands its error here first, so a ctrl-c is not stepped past
def opRethrowInterrupt [e: record] {
  if (opInterrupted \$e) {
    \$e.raw
  }
}

# NuSh.quietInterrupt, line for line, for the child nu a command runs in
def opQuietInterrupt [body: string] {
  let stop = [
    r#'if (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {'#
    r#'  exit 130'#
    r#'}'#
    r#'\$e.raw'#
  ] | each { |l| \$\\"  (\$l)\\" }
  [r#'try {'# r#'try {'# \$body r#'} catch { |e|'# ...\$stop r#'}'# r#'} catch { |e|'# ...\$stop r#'}'#] | str join \\"\\\\n\\"
}

def opRunCmd --wrapped [...args] {
  ^(\$nu.current-exe) --no-config-file -c (opQuietInterrupt \$\\"(\$args | flatten | str join ' ')\\")
}

def opRunSilentCmd --wrapped [...args] {
  ^(\$nu.current-exe) --no-config-file -c (opQuietInterrupt \$\\"(\$args | flatten | str join ' ') o+e> | silent\\")
}

# a yes/no question: empty, y or yes is yes, and YES answers yes without asking. with no terminal to answer from,
# as under cron or a pipe, it is no: input would fail there with an i/o error
def opAsk [question: string] {
  if 'YES' in \$env {
    return true
  }
  if not (is-terminal --stdin) {
    opPrintWarn \$\\"(\$question): no terminal to answer from, so no; YES answers yes\\"
    return false
  }
  # a question starts a step of its own: one blank line before it, and what it lets through right below the answer
  opPrint ''
  let yn = (input \$\\"(\$question) [[y]/n]: \\" | str lowercase)
  \$yn in ['' 'y' 'yes']
}

def opMaybeRunCmd --wrapped [...args] {
  if DRYRUN not-in \$env {
    opRunCmd ...\$args
  }
}

def opMaybeRunSilentCmd --wrapped [...args] {
  if DRYRUN not-in \$env {
    opRunSilentCmd ...\$args
  }
}

def opPrintRunCmd --wrapped [...args] {
  opPrintCmd ...\$args
  opRunCmd ...\$args
}

def opPrintMaybeRunCmd --wrapped [...args] {
  opPrintCmd ...\$args
  opMaybeRunCmd ...\$args
}


\$env.SH_VERS_MAJOR = 0

\$env.SH_VERS_MINOR = 116

do {
  let major = \$env.SH_VERS_MAJOR | into int
  let minor = \$env.SH_VERS_MINOR | into int

  if ((version | get major) < \$major) or ((version | get minor) < \$minor) {
    opPrintErr \$\\"nu must be >= '(\$major).(\$minor)' .. found '(version | get version)' .. aborting\\"
    exit 1
  }
}


\$env.NU_VERS_MAJOR = 0

\$env.NU_VERS_MINOR = 116

\$env.NU_VERS_PATCH = 0

\$env.REQ_ORIG = r#'http://x'#

\$env.SYS_OS_PLAT = r#'linux'#

\$env.REQ_PATH = r#'/sh/nu/file/outdated/zsh'#

\$env.REQ_SRCH = r#'?sysOsPlat=linux&wutNuPinned=1'#

def wutNuVersCurrent [nu_bin: string, nu_vers: string] {
  if not (\$nu_bin | path exists) {
    return false
  }
  let installed = (do { ^\$nu_bin --version } | complete)
  if \$installed.exit_code != 0 {
    return false
  }
  (\$installed.stdout | str trim) == \$nu_vers
}

def wutNuLockRelease [lock_path: string] {
  rm --force \$lock_path
  # best-effort: only succeeds if now empty, so a concurrent process's own in-flight files are never touched
  try { rm (\$lock_path | path dirname) } catch { |e| opRethrowInterrupt \$e }
}

def wutNuInstall [wut_home: string, nu_bin: string, nu_vers: string, ext: string] {
  if (wutNuVersCurrent \$nu_bin \$nu_vers) {
    opPrintVerbose \$\\"nu (\$nu_vers): current at (\$nu_bin)\\"
    return
  }
  let found = if (\$nu_bin | path exists) { (do { ^\$nu_bin --version } | complete).stdout | str trim } else { '' }
  opPrintVerbose \$\\"nu (\$nu_vers): (\$nu_bin) has (if (\$found | is-empty) { 'none' } else { \$found }), syncing\\"

  let triple = match \$\\"(\$env.SYS_OS_PLAT)_(\$env.SYS_CPU_ARCH)\\" {
    'darwin_aarch64' => 'aarch64-apple-darwin',
    'darwin_x86_64' => 'x86_64-apple-darwin',
    'linux_aarch64' => 'aarch64-unknown-linux-gnu',
    'linux_x86_64' => 'x86_64-unknown-linux-gnu',
    'windows_aarch64' => 'aarch64-pc-windows-msvc',
    'windows_x86_64' => 'x86_64-pc-windows-msvc',
    _ => '',
  }
  let gnu_loader = if \$env.SYS_CPU_ARCH == 'aarch64' { '/lib/ld-linux-aarch64.so.1' } else { '/lib64/ld-linux-x86-64.so.2' }
  let musl = (\$triple | str ends-with '-gnu') and ((glob '/lib/ld-musl-*.so.1' | is-not-empty) or not (\$gnu_loader | path exists))
  let triple = if \$musl { \$triple | str replace --regex '-gnu\$' '-musl' } else { \$triple }
  if \$triple == '' {
    opPrintErr \$\\"unsupported platform/arch for nu sync: (\$env.SYS_OS_PLAT)/(\$env.SYS_CPU_ARCH)\\"
    exit 1
  }

  # a hidden dir nested inside vendor (not vendor itself) so a fresh download can never collide with the pinned nu_bin path
  let work_dir = (\$wut_home | path join 'vendor' '.nu')
  mkdir \$work_dir

  let lock_path = (\$work_dir | path join 'nu.lock')
  mut acquired = false
  mut waited = 0
  while \$waited < 240 {
    if (wutNuVersCurrent \$nu_bin \$nu_vers) {
      return
    }
    let locked = (try { \\"\\" | save \$lock_path; true } catch { |e| opRethrowInterrupt \$e; false })
    if \$locked {
      \$acquired = true
      break
    }
    if \$waited == 0 {
      opPrintVerbose \$\\"nu (\$nu_vers): waiting on another sync's lock (\$lock_path)\\"
    }
    sleep 500ms
    \$waited = \$waited + 1
  }
  if not \$acquired {
    opPrintWarn \$\\"reclaiming stale nu sync lock: (\$lock_path)\\"
    rm --force \$lock_path
    let locked = (try { \\"\\" | save \$lock_path; true } catch { |e| opRethrowInterrupt \$e; false })
    if not \$locked {
      opPrintErr \$\\"failed to acquire nu sync lock: (\$lock_path)\\"
      exit 1
    }
  }

  if (wutNuVersCurrent \$nu_bin \$nu_vers) {
    wutNuLockRelease \$lock_path
    return
  }

  let ext_archive = if \$env.SYS_OS_PLAT == 'windows' { 'zip' } else { 'tar.gz' }
  let asset = \$\\"nu-(\$nu_vers)-(\$triple).(\$ext_archive)\\"
  let url = \$\\"https://github.com/nushell/nushell/releases/download/(\$nu_vers)/(\$asset)\\"
  let archive_path = (\$work_dir | path join \$asset)
  let extract_dir = (\$work_dir | path join \$\\"nu-(\$nu_vers)-(\$triple)\\")

  rm --force --recursive \$archive_path \$extract_dir

  opPrintVerbose \$\\"nu (\$nu_vers): fetching (\$url)\\"
  let fetched = (do { ^curl --fail-with-body --location --no-progress-meter --output \$archive_path --url \$url } | complete)
  if \$fetched.exit_code != 0 {
    opPrintErr (\$fetched.stderr | str trim)
    opPrintErr \$\\"failed to download nu (\$nu_vers): (\$url)\\"
    rm --force \$archive_path
    wutNuLockRelease \$lock_path
    exit 1
  }

  let sums_url = \$\\"https://github.com/nushell/nushell/releases/download/(\$nu_vers)/SHA256SUMS\\"
  opPrintVerbose \$\\"nu (\$nu_vers): checking against (\$sums_url)\\"
  let sums = (do { ^curl --fail-with-body --location --no-progress-meter --url \$sums_url } | complete)
  let want = (\$sums.stdout | lines | split column --regex '\\\\s+' sum name | where name == \$asset | get -o 0.sum | default '')
  let got = (open --raw \$archive_path | hash sha256)
  if \$sums.exit_code != 0 or (\$want | is-empty) or \$got != \$want {
    opPrintErr \$\\"nu (\$nu_vers): (\$asset) does not match the release's SHA256SUMS\\"
    rm --force \$archive_path
    wutNuLockRelease \$lock_path
    exit 1
  }

  # zip assets (windows) have no wrapping folder, unlike tar.gz assets, so they must extract directly into
  # extract_dir; tar.gz assets already contain their own nu-(\$nu_vers)-(\$triple) folder, so they extract into work_dir
  let extract_target = if \$ext_archive == 'zip' {
    mkdir \$extract_dir
    \$extract_dir
  } else {
    \$work_dir
  }
  opPrintVerbose \$\\"nu (\$nu_vers): extracting into (\$extract_target)\\"
  let extracted = (do { ^tar -xf \$archive_path -C \$extract_target } | complete)
  if \$extracted.exit_code != 0 {
    opPrintErr (\$extracted.stderr | str trim)
    opPrintErr \$\\"failed to extract nu (\$nu_vers)\\"
    rm --force --recursive \$archive_path \$extract_dir
    wutNuLockRelease \$lock_path
    exit 1
  }

  let extracted_bin = (\$extract_dir | path join \$\\"nu(\$ext)\\")
  if not (\$extracted_bin | path exists) {
    opPrintErr \$\\"nu binary not found in extracted archive: (\$extract_dir)\\"
    rm --force --recursive \$archive_path \$extract_dir
    wutNuLockRelease \$lock_path
    exit 1
  }

  if \$env.SYS_OS_PLAT != 'windows' {
    ^chmod +x \$extracted_bin
  }
  mv --force \$extracted_bin \$nu_bin
  rm --force --recursive \$archive_path \$extract_dir
  opPrintVerbose \$\\"nu (\$nu_vers): installed at (\$nu_bin)\\"

  wutNuLockRelease \$lock_path
}

def --env wutNuSync [] {
  if \$env.SYS_OS_PLAT not-in ['darwin' 'linux' 'windows'] {
    opPrintWarn 'script is for darwin, linux, or windows'
    return
  }

  # windows has no HOME, and default's argument is evaluated even when WUT_HOME is set, so nu's own answer stands in,
  # as it does for the lock
  \$env.WUT_HOME = (\$env.WUT_HOME? | default (\$nu.home-dir | path join '.wut'))
  let wut_home = \$env.WUT_HOME
  let ext = if \$env.SYS_OS_PLAT == 'windows' { '.exe' } else { '' }
  let nu_bin = (\$wut_home | path join 'vendor' \$\\"nu(\$ext)\\")
  let nu_vers = \$\\"(\$env.NU_VERS_MAJOR).(\$env.NU_VERS_MINOR).(\$env.NU_VERS_PATCH)\\"

  wutNuInstall \$wut_home \$nu_bin \$nu_vers \$ext
}

wutNuSync

# pwsh's module dirs would otherwise leak into windows powershell (scoop)
if \$env.SYS_OS_PLAT == 'windows' {
  hide-env -i PSModulePath
}


# a tool this run installed, or one installed since the calling shell started, lands somewhere that shell's PATH may
# not reach yet. the env stage wut deploys already knows every such place, and adds each once it exists, so the run
# asks the native shell for the PATH a new one would start with, rather than leaving the next step to find nothing.
# windows keeps PATH in the registry too, where installers record theirs, so that joins what the profile builds
def --env wutPathRefresh [] {
  let out = if \$env.SYS_OS_PLAT? == 'windows' {
    if (which pwsh | is-empty) {
      return
    }
    let cmd = \\"\$sep = [IO.Path]::PathSeparator; \$reg = @('Machine', 'User') | ForEach-Object { [Environment]::GetEnvironmentVariable('Path', \$_) }; (((\$env:PATH -split \$sep) + (\$reg -split \$sep)) | Where-Object { \$_ } | Select-Object -Unique) -join \$sep\\"
    ^pwsh -NoLogo -Command \$cmd | complete
  } else {
    if (which zsh | is-empty) {
      return
    }
    ^zsh -c 'print -r -- \$PATH' | complete
  }
  # the last line, since an env stage is free to print on its way through
  let path = (\$out.stdout | lines | where { is-not-empty } | last 1 | get -o 0)
  if \$out.exit_code != 0 or \$path == null {
    return
  }
  \$env.PATH = (\$path | split row (char esep) | where { is-not-empty } | uniq)
}


wutPathRefresh

\$env.FILE_OUTDATED_PARTS = r#'zsh'#

# ghpm's table: a rule as wide as each header, columns padded to their widest cell, the last one loose. a column no
# row fills says nothing, so it is left out: a plan of only loose names has no group to show
def wutTable [headers: list<string>, rows: list<list<string>>] {
  let keep = (\$headers | enumerate | where { |h|
    (\$rows | is-empty) or (\$rows | any { |r| \$r | get -o \$h.index | default '' | is-not-empty })
  } | get index)
  let headers = (\$keep | each { |i| \$headers | get \$i })
  let rows = (\$rows | each { |r| \$keep | each { |i| \$r | get -o \$i | default '' } })
  let widths = (\$headers | enumerate | each { |h|
    [(\$h.item | str length)] ++ (\$rows | each { |r| \$r | get -o \$h.index | default '' | str length }) | math max
  })
  let line = { |cells: list<string>|
    \$cells | enumerate | each { |c|
      if \$c.index == ((\$cells | length) - 1) { \$c.item } else { \$c.item | fill --alignment left --width (\$widths | get \$c.index) }
    } | str join ' ' | str trim --right
  }
  opPrint (do \$line \$headers)
  opPrint (do \$line (\$headers | each { |h| '-' | fill --alignment left --width (\$h | str length) --character '-' }))
  for r in \$rows { opPrint (do \$line \$r) }
}

def wutSelectParse [choice: string, max: int] {
  let trimmed = (\$choice | str trim)
  if (\$trimmed | is-empty) {
    return (1..\$max | each { |i| \$i })
  }
  mut picked = []
  for part in (\$trimmed | split row --regex '[, ]+' | where { |p| \$p | is-not-empty }) {
    let bounds = if (\$part | str contains '-') {
      let halves = (\$part | split row '-')
      if (\$halves | length) != 2 {
        return null
      }
      [(try { \$halves | get 0 | into int } catch { |e| opRethrowInterrupt \$e; null }), (try { \$halves | get 1 | into int } catch { |e| opRethrowInterrupt \$e; null })]
    } else {
      let n = (try { \$part | into int } catch { |e| opRethrowInterrupt \$e; null })
      if \$n == 0 {
        return null
      }
      [\$n, \$n]
    }
    let from = (\$bounds | get 0)
    let to = (\$bounds | get 1)
    if \$from == null or \$to == null or \$from < 1 or \$to > \$max or \$from > \$to {
      return null
    }
    for i in \$from..\$to {
      if \$i not-in \$picked {
        \$picked = (\$picked | append \$i)
      }
    }
  }
  \$picked | sort
}

def wutSelectRead [max: int] {
  # -y answers the question, it does not skip the step: what was picked runs after a blank, as it does under the question
  if YES in \$env {
    opPrint ''
    return (1..\$max | each { |i| \$i })
  }
  # with no terminal to choose from, as under cron or a pipe, nothing is picked, the way a question there is no
  if not (is-terminal --stdin) {
    opPrintWarn 'no terminal to choose from, so none; -y picks all'
    return null
  }
  opPrint ''
  wutSelectParse (input \$\\"enter number\\\\(s\\\\) [empty=all] \\\\(0=quit | 1[,][-](\$max)\\\\): \\") \$max
}


# one lock for the whole machine, held by whatever is about to change it; see docs/OPS.md (One host lock)

def wutLockPath [] {
  \$env.WUT_HOME? | default (\$nu.home-dir | path join '.wut') | path join 'lock' 'host'
}

# a pid and when it started, so a pid handed on to another process since is not taken for the holder
def wutLockStamp [pid: int] {
  let found = (ps --long | where pid == \$pid)
  if (\$found | is-empty) {
    return ''
  }
  let started = (\$found | first | get -o start_time)
  if \$started == null { \$\\"(\$pid)\\" } else { \$\\"(\$pid) (\$started | format date '%s')\\" }
}

def wutLockRead [dir: string, file: string] {
  try { open --raw (\$dir | path join \$file) | str trim } catch { |e| opRethrowInterrupt \$e; '' }
}

def wutLockHolderPid [held: string] {
  try { \$held | split row ' ' | first | into int } catch { |e| opRethrowInterrupt \$e; -1 }
}

# the os's own mkdir, which fails when the dir is already there; nu's is mkdir -p
def wutLockMake [dir: string] {
  let parent = (\$dir | path dirname)
  mkdir \$parent
  let made = if \$nu.os-info.name == 'windows' {
    do { cd \$parent; ^cmd /c mkdir (\$dir | path basename) } | complete
  } else {
    do { ^mkdir \$dir } | complete
  }
  \$made.exit_code == 0
}

# this process and every one it descends from
def wutLockLineage [] {
  let procs = (ps | select pid ppid)
  mut line = [\$nu.pid]
  mut at = \$nu.pid
  for _ in 1..64 {
    let up = (\$procs | where pid == \$at | get -o 0.ppid)
    if \$up == null or \$up <= 0 or \$up in \$line {
      break
    }
    \$line = (\$line | append \$up)
    \$at = \$up
  }
  \$line
}

# the lock is this run's when this process or one it descends from holds it: the stamp it hands down through
# WUT_LOCK_HOST, or failing that its pid in this one's lineage, since sudo, su and a service start a child without
# that environment
def wutLockMine [dir: string] {
  let held = (wutLockRead \$dir 'pid')
  let pid = (wutLockHolderPid \$held)
  if \$pid < 0 or (wutLockStamp \$pid) != \$held {
    return false
  }
  (\$env.WUT_LOCK_HOST? | default '') == \$held or \$pid in (wutLockLineage)
}

# where a run is about to change the machine: takes the host lock, waiting for whoever holds it, and says once who
# that is. outside a wutLockScope it does nothing, so a reading op that shares a runner with a changing one takes none
def --env wutLockHold [] {
  let what = (\$env.WUT_LOCK_SCOPE? | default '')
  if \$what == '' {
    return
  }
  let dir = (wutLockPath)
  if (wutLockMine \$dir) {
    return
  }
  let own = (wutLockStamp \$nu.pid)
  mut told = false
  loop {
    if (wutLockMake \$dir) {
      \$what | save --force (\$dir | path join 'what')
      \$own | save --force (\$dir | path join 'pid')
      load-env {WUT_LOCK_HOST: \$own}
      return
    }
    let held = (wutLockRead \$dir 'pid')
    if \$held == '' {
      let made = (try { ls --directory \$dir | first | get modified } catch { |e| opRethrowInterrupt \$e; date now })
      if ((date now) - \$made) < 5sec {
        sleep 100ms
        continue
      }
    } else {
      let pid = (wutLockHolderPid \$held)
      if \$pid >= 0 and (wutLockStamp \$pid) == \$held {
        if not \$told {
          opPrintInfo \$\\"waiting for \`wut (wutLockRead \$dir 'what')\` \\\\(pid (\$pid)\\\\) to finish changing this host\\"
          \$told = true
        }
        sleep 250ms
        continue
      }
    }
    if (wutLockRead \$dir 'pid') == \$held {
      rm --recursive --force \$dir
    }
  }
}

# a run that may change the machine runs inside this: what wutLockHold takes in it is given back when it ends,
# however it ends. what: the command a waiting run names, \`pack sync\`
def --env wutLockScope [what: string, work: closure] {
  let dir = (wutLockPath)
  let had = (wutLockMine \$dir)
  let outer = (\$env.WUT_LOCK_SCOPE? | default '')
  \$env.WUT_LOCK_SCOPE = (if \$outer == '' { \$what } else { \$outer })
  let release = {||
    if not \$had and (wutLockRead \$dir 'pid') == (wutLockStamp \$nu.pid) {
      rm --recursive --force \$dir
    }
  }
  try {
    do --env \$work
  } catch { |e|
    do \$release
    opRethrowInterrupt \$e
    \$e.raw
  }
  do \$release
  if \$outer == '' {
    hide-env -i WUT_LOCK_SCOPE
  }
}


def replaceEnv [line] {
  mut l = \$line
  if (\$l | str contains '{') {
    let itemsEnv = \$env | items { |key, value| [\$key, \$value] }
    for e in (\$itemsEnv | where { |e| ((\$e.0 | describe) == string) and ((\$e.1 | describe) == string) }) {
      \$l = \$l | str replace --all \$\\"{(\$e.0)}\\" (\$e.1)
    }
  }
  return \$l
}

# a tool's key is the bin to look for: a config for something not installed is skipped rather than written
def fileBinHere [tool: string] {
  which \$tool | is-not-empty
}

# one field of a plan entry, which is the key and then its parts, joined by |
def fileField [entry: string, i: int] {
  \$entry | split row '|' | get \$i
}

def fileDst [raw: string] {
  replaceEnv \$raw | path expand
}

def fileOf [entries: list, tool: string] {
  \$entries | where { |e| (fileField \$e 0) == \$tool }
}

# remove takes back what is on disk, whether or not the tool still is: a pack removes a tool's files before the tool
def fileToolHere [tool: string, pairs: list] {
  if \$env.FILE_OP? == 'remove' {
    fileOf \$pairs \$tool | any { |p| fileDst (fileField \$p 2) | path exists }
  } else {
    fileBinHere \$tool
  }
}

# the plan for the ops that act: which tools are here, each with the files it would write or remove, then a row per
# tool to pick. outdated fetches every source sync would, so it is gated the same
def filePlanShow [pairsKey: string, dirsKey: string, toolsKey: string] {
  let pairs = (\$env | get -o \$pairsKey | default [])
  let tools = (\$pairs | each { |p| fileField \$p 0 } | uniq | sort | where { |t| fileToolHere \$t \$pairs })
  if (\$tools | is-empty) {
    opPrintWarn (if \$env.FILE_OP == 'remove' { 'nothing to remove' } else { 'no tool here has files' })
    return false
  }
  for t in \$tools {
    opPrint \$t
    for p in (fileOf \$pairs \$t) {
      let dst = (fileDst (fileField \$p 2))
      if \$env.FILE_OP != 'remove' or (\$dst | path exists) {
        opPrint \$\\"  (\$dst)\\"
      }
    }
  }
  opPrint ''
  wutTable ['tool'] (\$tools | enumerate | each { |t| [\$\\"(\$t.index + 1)\\\\) (\$t.item)\\"] })
  let picked = (wutSelectRead (\$tools | length))
  if \$picked == null {
    return false
  }
  load-env {(\$toolsKey): (\$picked | each { |i| \$tools | get (\$i - 1) })}
  true
}

def fileFetch [src: string] {
  let srcUrl = \$\\"(\$env.REQ_URL_CFG)/file/(\$src | str trim --left --char '/')\\"
  opPrintCmd http get --raw --redirect-mode follow \$\\"r#'(\$srcUrl)'#\\"
  http get --raw --redirect-mode follow \$srcUrl
}

# what writing a source would do to its destination: nothing, a new file, or a changed one, by their bytes
def fileState [content, dst: string] {
  if not (\$dst | path exists) {
    'new'
  } else if (open --raw \$dst | hash sha256) == (\$content | hash sha256) {
    'same'
  } else {
    'changed'
  }
}

# files in a folder map's destination that its source no longer has: a sync takes them out, so the folder is the
# source's, without clearing and writing all of it again
def fileStray [tool: string, pairs: list, dirs: list] {
  let wanted = (fileOf \$pairs \$tool | each { |p| fileDst (fileField \$p 2) })
  fileOf \$dirs \$tool | each { |d| fileDst (fileField \$d 1) } | where { |d| \$d | path exists } | each { |d|
    # from inside the dir, so a windows path's separators are never read as a pattern's escapes
    do { cd \$d; glob '**/*' --no-dir } | where { |f| \$f not-in \$wanted }
  } | flatten
}

# what a sync of one tool would change, said and not done: each file it would write, with the diff of a changed one,
# and each it would take out
def fileOutdatedTool [tool: string, pairs: list, dirs: list] {
  mut pending = 0
  for p in (fileOf \$pairs \$tool) {
    let dst = (fileDst (fileField \$p 2))
    let content = (fileFetch (fileField \$p 1))
    let state = (fileState \$content \$dst)
    if \$state == 'same' {
      continue
    }
    \$pending += 1
    opPrint \$\\"  (\$state): (\$dst)\\"
    if \$state == 'changed' {
      let tmp = (mktemp --suffix '.file.outdated.tmp' --tmpdir)
      \$content | save --force --raw \$tmp
      let diffCmd = if (which diff | is-not-empty) { 'diff' } else { 'fc' }
      run-external \$diffCmd \$dst \$tmp | complete | get stdout | str trim --right | lines | each { |l| opPrint \$\\"    (\$l)\\" }
      rm --force \$tmp
    }
  }
  for f in (fileStray \$tool \$pairs \$dirs) {
    \$pending += 1
    opPrint \$\\"  stale: (\$f)\\"
  }
  if \$pending == 0 {
    opPrintInfo \$\\"(\$tool): up to date\\"
  }
}

# a sync of one tool writes only what differs from its source, takes out what its folder maps no longer have, and
# sets permissions where it wrote, so a sync that changes nothing writes nothing
def --env fileSyncTool [tool: string, pairs: list, dirs: list, perms: list] {
  mut wrote = false
  mut same = 0
  for p in (fileOf \$pairs \$tool) {
    let dst = (fileDst (fileField \$p 2))
    let content = (fileFetch (fileField \$p 1))
    let state = (fileState \$content \$dst)
    if \$state == 'same' {
      \$same += 1
      continue
    }
    let parent = (\$dst | path dirname)
    if not (\$parent | path exists) {
      opPrintMaybeRunCmd mkdir \$\\"r#'(\$parent)'#\\"
    }
    opPrintCmd save --force --raw \$\\"r#'(\$dst)'#\\"
    if 'DRYRUN' not-in \$env {
      \$content | save --force --raw \$dst
    }
    \$wrote = true
  }
  for f in (fileStray \$tool \$pairs \$dirs) {
    opPrintMaybeRunCmd rm --force --permanent \$\\"r#'(\$f)'#\\"
    \$wrote = true
  }
  if \$wrote {
    for perm in (fileOf \$perms \$tool) {
      opPrintMaybeRunCmd ...(replaceEnv (fileField \$perm 1) | split row ' ')
    }
  }
  if \$same > 0 {
    opPrintInfo \$\\"(\$tool): (\$same) unchanged\\"
  }
}

# a remove of one tool takes out every folder map's destination whole, and each file it wrote elsewhere
def --env fileRemoveTool [tool: string, pairs: list, dirs: list] {
  let dirPaths = (fileOf \$dirs \$tool | each { |d| fileDst (fileField \$d 1) })
  for d in (\$dirPaths | where { |d| \$d | path exists }) {
    opPrintMaybeRunCmd rm --force --permanent --recursive \$\\"r#'(\$d)'#\\"
  }
  for p in (fileOf \$pairs \$tool) {
    let dst = (fileDst (fileField \$p 2))
    if (\$dirPaths | any { |d| \$dst | str starts-with \$\\"(\$d)(char path_sep)\\" }) or not (\$dst | path exists) {
      continue
    }
    opPrintMaybeRunCmd rm --force --permanent \$\\"r#'(\$dst)'#\\"
  }
}

def fileToolChosen [toolsKey: string, tool: string] {
  let chosen = (\$env | get -o \$toolsKey | default [])
  (\$chosen | is-empty) or (\$tool in \$chosen)
}

def file [] {
  let op = \$env.FILE_OP
  let key = (\$op | str uppercase)
  let pairs = (\$env | get -o \$\\"FILE_(\$key)_PATH_PAIRS\\" | default [])
  let dirs = (\$env | get -o \$\\"FILE_(\$key)_DIRS\\" | default [])
  let perms = (\$env | get -o \$\\"FILE_(\$key)_PATH_PERMS\\" | default [])
  let tools = (\$pairs | each { |p| fileField \$p 0 } | uniq | sort | where { |t| fileToolChosen \$\\"FILE_(\$key)_TOOLS\\" \$t })
  match \$op {
    find => {
      let here = (
        (\$env.FILE_FIND_KEYS? | default []) | each { |entry| \$entry | split row '|' }
          | where { |parts| fileBinHere (\$parts | get 0) }
          | each { |parts| {
            bin: (\$parts | get 0),
            ins: (\$parts | get -o 1 | default ''),
          } }
      )
      for e in \$here {
        opPrint \$e.bin
        if (\$e.ins | is-not-empty) {
          opPrint \$\\"  (\$e.ins)\\"
        }
      }
    }
    list => {
      # what is in place on this machine: each file a tool here has, where it is
      for t in (\$tools | where { |t| fileBinHere \$t }) {
        let present = (fileOf \$pairs \$t | each { |p| fileDst (fileField \$p 2) } | where { |d| \$d | path exists })
        if (\$present | is-not-empty) {
          opPrint \$t
          for d in \$present {
            opPrint \$\\"  (\$d)\\"
          }
        }
      }
    }
    outdated => {
      for t in \$tools {
        opPrint \$t
        fileOutdatedTool \$t \$pairs \$dirs
      }
    }
    sync => {
      wutLockHold
      for t in \$tools {
        fileSyncTool \$t \$pairs \$dirs \$perms
      }
    }
    remove => {
      wutLockHold
      for t in \$tools {
        fileRemoveTool \$t \$pairs \$dirs
      }
    }
  }
}


\$env.FILE_OUTDATED_PATH_PAIRS = [ r#'zsh|zsh/zsh/10-vim.zsh|{HOME}/.zsh/10-vim.zsh'#, r#'zsh|zsh/zshenv|{HOME}/.zshenv'#, r#'zsh|zsh/zshrc|{HOME}/.zshrc'# ]

\$env.FILE_OUTDATED_DIRS = [ r#'zsh|{HOME}/.zsh'# ]

\$env.FILE_OUTDATED_PATH_PERMS = [  ]

\$env.FILE_OP = r#'outdated'#

if not (filePlanShow 'FILE_OUTDATED_PATH_PAIRS' 'FILE_OUTDATED_DIRS' 'FILE_OUTDATED_TOOLS') {
  return
}
file

} catch { |e|
  if (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {
    exit 130
  }
  \$e.raw
}
} catch { |e|
  if (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {
    exit 130
  }
  \$e.raw
}"
`;

snapshot[`nu / linux / list (pinned, filtered) 1`] = `
"try {
try {
\$env.REQ_URL_CFG = r#'http://x/cfg'#

\$env.REQ_URL_SH = r#'http://x/sh/nu/file/list/zsh?sysOsPlat=linux&wutNuPinned=1'#

def opPrint --wrapped [...args] {
  \$\\"(\$args | flatten | str join ' ')\\" | print
}

def opPrintErr --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print --stderr
    return
  }
  \$\\"(ansi red)(\$args | flatten | str join ' ')(ansi reset)\\" | print --stderr
}

def opPrintSucc --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print
    return
  }
  \$\\"(ansi green)(\$args | flatten | str join ' ')(ansi reset)\\" | print
}

def opPrintWarn --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print
    return
  }
  \$\\"(ansi yellow)(\$args | flatten | str join ' ')(ansi reset)\\" | print
}

def opPrintInfo --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print
    return
  }
  \$\\"(ansi blue)(\$args | flatten | str join ' ')(ansi reset)\\" | print
}

def opPrintVerbose --wrapped [...args] {
  if VERBOSE not-in \$env {
    return
  }
  \$\\"(\$args | flatten | str join ' ')\\" | print --stderr
}

def opPrintCmd --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$\\"(\$args | flatten | str join ' ')\\" | print
    return
  }
  let args = \$args | flatten
  \$\\"(ansi magenta)(\$args | first)(ansi reset)\\" | print --no-newline
  if (\$args | length) > 1 {
    \$\\" (ansi cyan)(\$args | skip 1 | str join ' ')(ansi reset)\\" | print
  } else {
    print ''
  }
}

def opMaybePrintCmd --wrapped [...args] {
  if DRYRUN not-in \$env {
    opPrintCmd ...\$args
  }
}

# a ctrl-c: nu's own, an input prompt's, or the exit of a command it stopped (130, SIGINT, windows' ctrl-c status)
def opInterrupted [e: record] {
  (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510])
}

# a catch hands its error here first, so a ctrl-c is not stepped past
def opRethrowInterrupt [e: record] {
  if (opInterrupted \$e) {
    \$e.raw
  }
}

# NuSh.quietInterrupt, line for line, for the child nu a command runs in
def opQuietInterrupt [body: string] {
  let stop = [
    r#'if (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {'#
    r#'  exit 130'#
    r#'}'#
    r#'\$e.raw'#
  ] | each { |l| \$\\"  (\$l)\\" }
  [r#'try {'# r#'try {'# \$body r#'} catch { |e|'# ...\$stop r#'}'# r#'} catch { |e|'# ...\$stop r#'}'#] | str join \\"\\\\n\\"
}

def opRunCmd --wrapped [...args] {
  ^(\$nu.current-exe) --no-config-file -c (opQuietInterrupt \$\\"(\$args | flatten | str join ' ')\\")
}

def opRunSilentCmd --wrapped [...args] {
  ^(\$nu.current-exe) --no-config-file -c (opQuietInterrupt \$\\"(\$args | flatten | str join ' ') o+e> | silent\\")
}

# a yes/no question: empty, y or yes is yes, and YES answers yes without asking. with no terminal to answer from,
# as under cron or a pipe, it is no: input would fail there with an i/o error
def opAsk [question: string] {
  if 'YES' in \$env {
    return true
  }
  if not (is-terminal --stdin) {
    opPrintWarn \$\\"(\$question): no terminal to answer from, so no; YES answers yes\\"
    return false
  }
  # a question starts a step of its own: one blank line before it, and what it lets through right below the answer
  opPrint ''
  let yn = (input \$\\"(\$question) [[y]/n]: \\" | str lowercase)
  \$yn in ['' 'y' 'yes']
}

def opMaybeRunCmd --wrapped [...args] {
  if DRYRUN not-in \$env {
    opRunCmd ...\$args
  }
}

def opMaybeRunSilentCmd --wrapped [...args] {
  if DRYRUN not-in \$env {
    opRunSilentCmd ...\$args
  }
}

def opPrintRunCmd --wrapped [...args] {
  opPrintCmd ...\$args
  opRunCmd ...\$args
}

def opPrintMaybeRunCmd --wrapped [...args] {
  opPrintCmd ...\$args
  opMaybeRunCmd ...\$args
}


\$env.SH_VERS_MAJOR = 0

\$env.SH_VERS_MINOR = 116

do {
  let major = \$env.SH_VERS_MAJOR | into int
  let minor = \$env.SH_VERS_MINOR | into int

  if ((version | get major) < \$major) or ((version | get minor) < \$minor) {
    opPrintErr \$\\"nu must be >= '(\$major).(\$minor)' .. found '(version | get version)' .. aborting\\"
    exit 1
  }
}


\$env.NU_VERS_MAJOR = 0

\$env.NU_VERS_MINOR = 116

\$env.NU_VERS_PATCH = 0

\$env.REQ_ORIG = r#'http://x'#

\$env.SYS_OS_PLAT = r#'linux'#

\$env.REQ_PATH = r#'/sh/nu/file/list/zsh'#

\$env.REQ_SRCH = r#'?sysOsPlat=linux&wutNuPinned=1'#

def wutNuVersCurrent [nu_bin: string, nu_vers: string] {
  if not (\$nu_bin | path exists) {
    return false
  }
  let installed = (do { ^\$nu_bin --version } | complete)
  if \$installed.exit_code != 0 {
    return false
  }
  (\$installed.stdout | str trim) == \$nu_vers
}

def wutNuLockRelease [lock_path: string] {
  rm --force \$lock_path
  # best-effort: only succeeds if now empty, so a concurrent process's own in-flight files are never touched
  try { rm (\$lock_path | path dirname) } catch { |e| opRethrowInterrupt \$e }
}

def wutNuInstall [wut_home: string, nu_bin: string, nu_vers: string, ext: string] {
  if (wutNuVersCurrent \$nu_bin \$nu_vers) {
    opPrintVerbose \$\\"nu (\$nu_vers): current at (\$nu_bin)\\"
    return
  }
  let found = if (\$nu_bin | path exists) { (do { ^\$nu_bin --version } | complete).stdout | str trim } else { '' }
  opPrintVerbose \$\\"nu (\$nu_vers): (\$nu_bin) has (if (\$found | is-empty) { 'none' } else { \$found }), syncing\\"

  let triple = match \$\\"(\$env.SYS_OS_PLAT)_(\$env.SYS_CPU_ARCH)\\" {
    'darwin_aarch64' => 'aarch64-apple-darwin',
    'darwin_x86_64' => 'x86_64-apple-darwin',
    'linux_aarch64' => 'aarch64-unknown-linux-gnu',
    'linux_x86_64' => 'x86_64-unknown-linux-gnu',
    'windows_aarch64' => 'aarch64-pc-windows-msvc',
    'windows_x86_64' => 'x86_64-pc-windows-msvc',
    _ => '',
  }
  let gnu_loader = if \$env.SYS_CPU_ARCH == 'aarch64' { '/lib/ld-linux-aarch64.so.1' } else { '/lib64/ld-linux-x86-64.so.2' }
  let musl = (\$triple | str ends-with '-gnu') and ((glob '/lib/ld-musl-*.so.1' | is-not-empty) or not (\$gnu_loader | path exists))
  let triple = if \$musl { \$triple | str replace --regex '-gnu\$' '-musl' } else { \$triple }
  if \$triple == '' {
    opPrintErr \$\\"unsupported platform/arch for nu sync: (\$env.SYS_OS_PLAT)/(\$env.SYS_CPU_ARCH)\\"
    exit 1
  }

  # a hidden dir nested inside vendor (not vendor itself) so a fresh download can never collide with the pinned nu_bin path
  let work_dir = (\$wut_home | path join 'vendor' '.nu')
  mkdir \$work_dir

  let lock_path = (\$work_dir | path join 'nu.lock')
  mut acquired = false
  mut waited = 0
  while \$waited < 240 {
    if (wutNuVersCurrent \$nu_bin \$nu_vers) {
      return
    }
    let locked = (try { \\"\\" | save \$lock_path; true } catch { |e| opRethrowInterrupt \$e; false })
    if \$locked {
      \$acquired = true
      break
    }
    if \$waited == 0 {
      opPrintVerbose \$\\"nu (\$nu_vers): waiting on another sync's lock (\$lock_path)\\"
    }
    sleep 500ms
    \$waited = \$waited + 1
  }
  if not \$acquired {
    opPrintWarn \$\\"reclaiming stale nu sync lock: (\$lock_path)\\"
    rm --force \$lock_path
    let locked = (try { \\"\\" | save \$lock_path; true } catch { |e| opRethrowInterrupt \$e; false })
    if not \$locked {
      opPrintErr \$\\"failed to acquire nu sync lock: (\$lock_path)\\"
      exit 1
    }
  }

  if (wutNuVersCurrent \$nu_bin \$nu_vers) {
    wutNuLockRelease \$lock_path
    return
  }

  let ext_archive = if \$env.SYS_OS_PLAT == 'windows' { 'zip' } else { 'tar.gz' }
  let asset = \$\\"nu-(\$nu_vers)-(\$triple).(\$ext_archive)\\"
  let url = \$\\"https://github.com/nushell/nushell/releases/download/(\$nu_vers)/(\$asset)\\"
  let archive_path = (\$work_dir | path join \$asset)
  let extract_dir = (\$work_dir | path join \$\\"nu-(\$nu_vers)-(\$triple)\\")

  rm --force --recursive \$archive_path \$extract_dir

  opPrintVerbose \$\\"nu (\$nu_vers): fetching (\$url)\\"
  let fetched = (do { ^curl --fail-with-body --location --no-progress-meter --output \$archive_path --url \$url } | complete)
  if \$fetched.exit_code != 0 {
    opPrintErr (\$fetched.stderr | str trim)
    opPrintErr \$\\"failed to download nu (\$nu_vers): (\$url)\\"
    rm --force \$archive_path
    wutNuLockRelease \$lock_path
    exit 1
  }

  let sums_url = \$\\"https://github.com/nushell/nushell/releases/download/(\$nu_vers)/SHA256SUMS\\"
  opPrintVerbose \$\\"nu (\$nu_vers): checking against (\$sums_url)\\"
  let sums = (do { ^curl --fail-with-body --location --no-progress-meter --url \$sums_url } | complete)
  let want = (\$sums.stdout | lines | split column --regex '\\\\s+' sum name | where name == \$asset | get -o 0.sum | default '')
  let got = (open --raw \$archive_path | hash sha256)
  if \$sums.exit_code != 0 or (\$want | is-empty) or \$got != \$want {
    opPrintErr \$\\"nu (\$nu_vers): (\$asset) does not match the release's SHA256SUMS\\"
    rm --force \$archive_path
    wutNuLockRelease \$lock_path
    exit 1
  }

  # zip assets (windows) have no wrapping folder, unlike tar.gz assets, so they must extract directly into
  # extract_dir; tar.gz assets already contain their own nu-(\$nu_vers)-(\$triple) folder, so they extract into work_dir
  let extract_target = if \$ext_archive == 'zip' {
    mkdir \$extract_dir
    \$extract_dir
  } else {
    \$work_dir
  }
  opPrintVerbose \$\\"nu (\$nu_vers): extracting into (\$extract_target)\\"
  let extracted = (do { ^tar -xf \$archive_path -C \$extract_target } | complete)
  if \$extracted.exit_code != 0 {
    opPrintErr (\$extracted.stderr | str trim)
    opPrintErr \$\\"failed to extract nu (\$nu_vers)\\"
    rm --force --recursive \$archive_path \$extract_dir
    wutNuLockRelease \$lock_path
    exit 1
  }

  let extracted_bin = (\$extract_dir | path join \$\\"nu(\$ext)\\")
  if not (\$extracted_bin | path exists) {
    opPrintErr \$\\"nu binary not found in extracted archive: (\$extract_dir)\\"
    rm --force --recursive \$archive_path \$extract_dir
    wutNuLockRelease \$lock_path
    exit 1
  }

  if \$env.SYS_OS_PLAT != 'windows' {
    ^chmod +x \$extracted_bin
  }
  mv --force \$extracted_bin \$nu_bin
  rm --force --recursive \$archive_path \$extract_dir
  opPrintVerbose \$\\"nu (\$nu_vers): installed at (\$nu_bin)\\"

  wutNuLockRelease \$lock_path
}

def --env wutNuSync [] {
  if \$env.SYS_OS_PLAT not-in ['darwin' 'linux' 'windows'] {
    opPrintWarn 'script is for darwin, linux, or windows'
    return
  }

  # windows has no HOME, and default's argument is evaluated even when WUT_HOME is set, so nu's own answer stands in,
  # as it does for the lock
  \$env.WUT_HOME = (\$env.WUT_HOME? | default (\$nu.home-dir | path join '.wut'))
  let wut_home = \$env.WUT_HOME
  let ext = if \$env.SYS_OS_PLAT == 'windows' { '.exe' } else { '' }
  let nu_bin = (\$wut_home | path join 'vendor' \$\\"nu(\$ext)\\")
  let nu_vers = \$\\"(\$env.NU_VERS_MAJOR).(\$env.NU_VERS_MINOR).(\$env.NU_VERS_PATCH)\\"

  wutNuInstall \$wut_home \$nu_bin \$nu_vers \$ext
}

wutNuSync

# pwsh's module dirs would otherwise leak into windows powershell (scoop)
if \$env.SYS_OS_PLAT == 'windows' {
  hide-env -i PSModulePath
}


# a tool this run installed, or one installed since the calling shell started, lands somewhere that shell's PATH may
# not reach yet. the env stage wut deploys already knows every such place, and adds each once it exists, so the run
# asks the native shell for the PATH a new one would start with, rather than leaving the next step to find nothing.
# windows keeps PATH in the registry too, where installers record theirs, so that joins what the profile builds
def --env wutPathRefresh [] {
  let out = if \$env.SYS_OS_PLAT? == 'windows' {
    if (which pwsh | is-empty) {
      return
    }
    let cmd = \\"\$sep = [IO.Path]::PathSeparator; \$reg = @('Machine', 'User') | ForEach-Object { [Environment]::GetEnvironmentVariable('Path', \$_) }; (((\$env:PATH -split \$sep) + (\$reg -split \$sep)) | Where-Object { \$_ } | Select-Object -Unique) -join \$sep\\"
    ^pwsh -NoLogo -Command \$cmd | complete
  } else {
    if (which zsh | is-empty) {
      return
    }
    ^zsh -c 'print -r -- \$PATH' | complete
  }
  # the last line, since an env stage is free to print on its way through
  let path = (\$out.stdout | lines | where { is-not-empty } | last 1 | get -o 0)
  if \$out.exit_code != 0 or \$path == null {
    return
  }
  \$env.PATH = (\$path | split row (char esep) | where { is-not-empty } | uniq)
}


wutPathRefresh

\$env.FILE_LIST_PARTS = r#'zsh'#

# ghpm's table: a rule as wide as each header, columns padded to their widest cell, the last one loose. a column no
# row fills says nothing, so it is left out: a plan of only loose names has no group to show
def wutTable [headers: list<string>, rows: list<list<string>>] {
  let keep = (\$headers | enumerate | where { |h|
    (\$rows | is-empty) or (\$rows | any { |r| \$r | get -o \$h.index | default '' | is-not-empty })
  } | get index)
  let headers = (\$keep | each { |i| \$headers | get \$i })
  let rows = (\$rows | each { |r| \$keep | each { |i| \$r | get -o \$i | default '' } })
  let widths = (\$headers | enumerate | each { |h|
    [(\$h.item | str length)] ++ (\$rows | each { |r| \$r | get -o \$h.index | default '' | str length }) | math max
  })
  let line = { |cells: list<string>|
    \$cells | enumerate | each { |c|
      if \$c.index == ((\$cells | length) - 1) { \$c.item } else { \$c.item | fill --alignment left --width (\$widths | get \$c.index) }
    } | str join ' ' | str trim --right
  }
  opPrint (do \$line \$headers)
  opPrint (do \$line (\$headers | each { |h| '-' | fill --alignment left --width (\$h | str length) --character '-' }))
  for r in \$rows { opPrint (do \$line \$r) }
}

def wutSelectParse [choice: string, max: int] {
  let trimmed = (\$choice | str trim)
  if (\$trimmed | is-empty) {
    return (1..\$max | each { |i| \$i })
  }
  mut picked = []
  for part in (\$trimmed | split row --regex '[, ]+' | where { |p| \$p | is-not-empty }) {
    let bounds = if (\$part | str contains '-') {
      let halves = (\$part | split row '-')
      if (\$halves | length) != 2 {
        return null
      }
      [(try { \$halves | get 0 | into int } catch { |e| opRethrowInterrupt \$e; null }), (try { \$halves | get 1 | into int } catch { |e| opRethrowInterrupt \$e; null })]
    } else {
      let n = (try { \$part | into int } catch { |e| opRethrowInterrupt \$e; null })
      if \$n == 0 {
        return null
      }
      [\$n, \$n]
    }
    let from = (\$bounds | get 0)
    let to = (\$bounds | get 1)
    if \$from == null or \$to == null or \$from < 1 or \$to > \$max or \$from > \$to {
      return null
    }
    for i in \$from..\$to {
      if \$i not-in \$picked {
        \$picked = (\$picked | append \$i)
      }
    }
  }
  \$picked | sort
}

def wutSelectRead [max: int] {
  # -y answers the question, it does not skip the step: what was picked runs after a blank, as it does under the question
  if YES in \$env {
    opPrint ''
    return (1..\$max | each { |i| \$i })
  }
  # with no terminal to choose from, as under cron or a pipe, nothing is picked, the way a question there is no
  if not (is-terminal --stdin) {
    opPrintWarn 'no terminal to choose from, so none; -y picks all'
    return null
  }
  opPrint ''
  wutSelectParse (input \$\\"enter number\\\\(s\\\\) [empty=all] \\\\(0=quit | 1[,][-](\$max)\\\\): \\") \$max
}


# one lock for the whole machine, held by whatever is about to change it; see docs/OPS.md (One host lock)

def wutLockPath [] {
  \$env.WUT_HOME? | default (\$nu.home-dir | path join '.wut') | path join 'lock' 'host'
}

# a pid and when it started, so a pid handed on to another process since is not taken for the holder
def wutLockStamp [pid: int] {
  let found = (ps --long | where pid == \$pid)
  if (\$found | is-empty) {
    return ''
  }
  let started = (\$found | first | get -o start_time)
  if \$started == null { \$\\"(\$pid)\\" } else { \$\\"(\$pid) (\$started | format date '%s')\\" }
}

def wutLockRead [dir: string, file: string] {
  try { open --raw (\$dir | path join \$file) | str trim } catch { |e| opRethrowInterrupt \$e; '' }
}

def wutLockHolderPid [held: string] {
  try { \$held | split row ' ' | first | into int } catch { |e| opRethrowInterrupt \$e; -1 }
}

# the os's own mkdir, which fails when the dir is already there; nu's is mkdir -p
def wutLockMake [dir: string] {
  let parent = (\$dir | path dirname)
  mkdir \$parent
  let made = if \$nu.os-info.name == 'windows' {
    do { cd \$parent; ^cmd /c mkdir (\$dir | path basename) } | complete
  } else {
    do { ^mkdir \$dir } | complete
  }
  \$made.exit_code == 0
}

# this process and every one it descends from
def wutLockLineage [] {
  let procs = (ps | select pid ppid)
  mut line = [\$nu.pid]
  mut at = \$nu.pid
  for _ in 1..64 {
    let up = (\$procs | where pid == \$at | get -o 0.ppid)
    if \$up == null or \$up <= 0 or \$up in \$line {
      break
    }
    \$line = (\$line | append \$up)
    \$at = \$up
  }
  \$line
}

# the lock is this run's when this process or one it descends from holds it: the stamp it hands down through
# WUT_LOCK_HOST, or failing that its pid in this one's lineage, since sudo, su and a service start a child without
# that environment
def wutLockMine [dir: string] {
  let held = (wutLockRead \$dir 'pid')
  let pid = (wutLockHolderPid \$held)
  if \$pid < 0 or (wutLockStamp \$pid) != \$held {
    return false
  }
  (\$env.WUT_LOCK_HOST? | default '') == \$held or \$pid in (wutLockLineage)
}

# where a run is about to change the machine: takes the host lock, waiting for whoever holds it, and says once who
# that is. outside a wutLockScope it does nothing, so a reading op that shares a runner with a changing one takes none
def --env wutLockHold [] {
  let what = (\$env.WUT_LOCK_SCOPE? | default '')
  if \$what == '' {
    return
  }
  let dir = (wutLockPath)
  if (wutLockMine \$dir) {
    return
  }
  let own = (wutLockStamp \$nu.pid)
  mut told = false
  loop {
    if (wutLockMake \$dir) {
      \$what | save --force (\$dir | path join 'what')
      \$own | save --force (\$dir | path join 'pid')
      load-env {WUT_LOCK_HOST: \$own}
      return
    }
    let held = (wutLockRead \$dir 'pid')
    if \$held == '' {
      let made = (try { ls --directory \$dir | first | get modified } catch { |e| opRethrowInterrupt \$e; date now })
      if ((date now) - \$made) < 5sec {
        sleep 100ms
        continue
      }
    } else {
      let pid = (wutLockHolderPid \$held)
      if \$pid >= 0 and (wutLockStamp \$pid) == \$held {
        if not \$told {
          opPrintInfo \$\\"waiting for \`wut (wutLockRead \$dir 'what')\` \\\\(pid (\$pid)\\\\) to finish changing this host\\"
          \$told = true
        }
        sleep 250ms
        continue
      }
    }
    if (wutLockRead \$dir 'pid') == \$held {
      rm --recursive --force \$dir
    }
  }
}

# a run that may change the machine runs inside this: what wutLockHold takes in it is given back when it ends,
# however it ends. what: the command a waiting run names, \`pack sync\`
def --env wutLockScope [what: string, work: closure] {
  let dir = (wutLockPath)
  let had = (wutLockMine \$dir)
  let outer = (\$env.WUT_LOCK_SCOPE? | default '')
  \$env.WUT_LOCK_SCOPE = (if \$outer == '' { \$what } else { \$outer })
  let release = {||
    if not \$had and (wutLockRead \$dir 'pid') == (wutLockStamp \$nu.pid) {
      rm --recursive --force \$dir
    }
  }
  try {
    do --env \$work
  } catch { |e|
    do \$release
    opRethrowInterrupt \$e
    \$e.raw
  }
  do \$release
  if \$outer == '' {
    hide-env -i WUT_LOCK_SCOPE
  }
}


def replaceEnv [line] {
  mut l = \$line
  if (\$l | str contains '{') {
    let itemsEnv = \$env | items { |key, value| [\$key, \$value] }
    for e in (\$itemsEnv | where { |e| ((\$e.0 | describe) == string) and ((\$e.1 | describe) == string) }) {
      \$l = \$l | str replace --all \$\\"{(\$e.0)}\\" (\$e.1)
    }
  }
  return \$l
}

# a tool's key is the bin to look for: a config for something not installed is skipped rather than written
def fileBinHere [tool: string] {
  which \$tool | is-not-empty
}

# one field of a plan entry, which is the key and then its parts, joined by |
def fileField [entry: string, i: int] {
  \$entry | split row '|' | get \$i
}

def fileDst [raw: string] {
  replaceEnv \$raw | path expand
}

def fileOf [entries: list, tool: string] {
  \$entries | where { |e| (fileField \$e 0) == \$tool }
}

# remove takes back what is on disk, whether or not the tool still is: a pack removes a tool's files before the tool
def fileToolHere [tool: string, pairs: list] {
  if \$env.FILE_OP? == 'remove' {
    fileOf \$pairs \$tool | any { |p| fileDst (fileField \$p 2) | path exists }
  } else {
    fileBinHere \$tool
  }
}

# the plan for the ops that act: which tools are here, each with the files it would write or remove, then a row per
# tool to pick. outdated fetches every source sync would, so it is gated the same
def filePlanShow [pairsKey: string, dirsKey: string, toolsKey: string] {
  let pairs = (\$env | get -o \$pairsKey | default [])
  let tools = (\$pairs | each { |p| fileField \$p 0 } | uniq | sort | where { |t| fileToolHere \$t \$pairs })
  if (\$tools | is-empty) {
    opPrintWarn (if \$env.FILE_OP == 'remove' { 'nothing to remove' } else { 'no tool here has files' })
    return false
  }
  for t in \$tools {
    opPrint \$t
    for p in (fileOf \$pairs \$t) {
      let dst = (fileDst (fileField \$p 2))
      if \$env.FILE_OP != 'remove' or (\$dst | path exists) {
        opPrint \$\\"  (\$dst)\\"
      }
    }
  }
  opPrint ''
  wutTable ['tool'] (\$tools | enumerate | each { |t| [\$\\"(\$t.index + 1)\\\\) (\$t.item)\\"] })
  let picked = (wutSelectRead (\$tools | length))
  if \$picked == null {
    return false
  }
  load-env {(\$toolsKey): (\$picked | each { |i| \$tools | get (\$i - 1) })}
  true
}

def fileFetch [src: string] {
  let srcUrl = \$\\"(\$env.REQ_URL_CFG)/file/(\$src | str trim --left --char '/')\\"
  opPrintCmd http get --raw --redirect-mode follow \$\\"r#'(\$srcUrl)'#\\"
  http get --raw --redirect-mode follow \$srcUrl
}

# what writing a source would do to its destination: nothing, a new file, or a changed one, by their bytes
def fileState [content, dst: string] {
  if not (\$dst | path exists) {
    'new'
  } else if (open --raw \$dst | hash sha256) == (\$content | hash sha256) {
    'same'
  } else {
    'changed'
  }
}

# files in a folder map's destination that its source no longer has: a sync takes them out, so the folder is the
# source's, without clearing and writing all of it again
def fileStray [tool: string, pairs: list, dirs: list] {
  let wanted = (fileOf \$pairs \$tool | each { |p| fileDst (fileField \$p 2) })
  fileOf \$dirs \$tool | each { |d| fileDst (fileField \$d 1) } | where { |d| \$d | path exists } | each { |d|
    # from inside the dir, so a windows path's separators are never read as a pattern's escapes
    do { cd \$d; glob '**/*' --no-dir } | where { |f| \$f not-in \$wanted }
  } | flatten
}

# what a sync of one tool would change, said and not done: each file it would write, with the diff of a changed one,
# and each it would take out
def fileOutdatedTool [tool: string, pairs: list, dirs: list] {
  mut pending = 0
  for p in (fileOf \$pairs \$tool) {
    let dst = (fileDst (fileField \$p 2))
    let content = (fileFetch (fileField \$p 1))
    let state = (fileState \$content \$dst)
    if \$state == 'same' {
      continue
    }
    \$pending += 1
    opPrint \$\\"  (\$state): (\$dst)\\"
    if \$state == 'changed' {
      let tmp = (mktemp --suffix '.file.outdated.tmp' --tmpdir)
      \$content | save --force --raw \$tmp
      let diffCmd = if (which diff | is-not-empty) { 'diff' } else { 'fc' }
      run-external \$diffCmd \$dst \$tmp | complete | get stdout | str trim --right | lines | each { |l| opPrint \$\\"    (\$l)\\" }
      rm --force \$tmp
    }
  }
  for f in (fileStray \$tool \$pairs \$dirs) {
    \$pending += 1
    opPrint \$\\"  stale: (\$f)\\"
  }
  if \$pending == 0 {
    opPrintInfo \$\\"(\$tool): up to date\\"
  }
}

# a sync of one tool writes only what differs from its source, takes out what its folder maps no longer have, and
# sets permissions where it wrote, so a sync that changes nothing writes nothing
def --env fileSyncTool [tool: string, pairs: list, dirs: list, perms: list] {
  mut wrote = false
  mut same = 0
  for p in (fileOf \$pairs \$tool) {
    let dst = (fileDst (fileField \$p 2))
    let content = (fileFetch (fileField \$p 1))
    let state = (fileState \$content \$dst)
    if \$state == 'same' {
      \$same += 1
      continue
    }
    let parent = (\$dst | path dirname)
    if not (\$parent | path exists) {
      opPrintMaybeRunCmd mkdir \$\\"r#'(\$parent)'#\\"
    }
    opPrintCmd save --force --raw \$\\"r#'(\$dst)'#\\"
    if 'DRYRUN' not-in \$env {
      \$content | save --force --raw \$dst
    }
    \$wrote = true
  }
  for f in (fileStray \$tool \$pairs \$dirs) {
    opPrintMaybeRunCmd rm --force --permanent \$\\"r#'(\$f)'#\\"
    \$wrote = true
  }
  if \$wrote {
    for perm in (fileOf \$perms \$tool) {
      opPrintMaybeRunCmd ...(replaceEnv (fileField \$perm 1) | split row ' ')
    }
  }
  if \$same > 0 {
    opPrintInfo \$\\"(\$tool): (\$same) unchanged\\"
  }
}

# a remove of one tool takes out every folder map's destination whole, and each file it wrote elsewhere
def --env fileRemoveTool [tool: string, pairs: list, dirs: list] {
  let dirPaths = (fileOf \$dirs \$tool | each { |d| fileDst (fileField \$d 1) })
  for d in (\$dirPaths | where { |d| \$d | path exists }) {
    opPrintMaybeRunCmd rm --force --permanent --recursive \$\\"r#'(\$d)'#\\"
  }
  for p in (fileOf \$pairs \$tool) {
    let dst = (fileDst (fileField \$p 2))
    if (\$dirPaths | any { |d| \$dst | str starts-with \$\\"(\$d)(char path_sep)\\" }) or not (\$dst | path exists) {
      continue
    }
    opPrintMaybeRunCmd rm --force --permanent \$\\"r#'(\$dst)'#\\"
  }
}

def fileToolChosen [toolsKey: string, tool: string] {
  let chosen = (\$env | get -o \$toolsKey | default [])
  (\$chosen | is-empty) or (\$tool in \$chosen)
}

def file [] {
  let op = \$env.FILE_OP
  let key = (\$op | str uppercase)
  let pairs = (\$env | get -o \$\\"FILE_(\$key)_PATH_PAIRS\\" | default [])
  let dirs = (\$env | get -o \$\\"FILE_(\$key)_DIRS\\" | default [])
  let perms = (\$env | get -o \$\\"FILE_(\$key)_PATH_PERMS\\" | default [])
  let tools = (\$pairs | each { |p| fileField \$p 0 } | uniq | sort | where { |t| fileToolChosen \$\\"FILE_(\$key)_TOOLS\\" \$t })
  match \$op {
    find => {
      let here = (
        (\$env.FILE_FIND_KEYS? | default []) | each { |entry| \$entry | split row '|' }
          | where { |parts| fileBinHere (\$parts | get 0) }
          | each { |parts| {
            bin: (\$parts | get 0),
            ins: (\$parts | get -o 1 | default ''),
          } }
      )
      for e in \$here {
        opPrint \$e.bin
        if (\$e.ins | is-not-empty) {
          opPrint \$\\"  (\$e.ins)\\"
        }
      }
    }
    list => {
      # what is in place on this machine: each file a tool here has, where it is
      for t in (\$tools | where { |t| fileBinHere \$t }) {
        let present = (fileOf \$pairs \$t | each { |p| fileDst (fileField \$p 2) } | where { |d| \$d | path exists })
        if (\$present | is-not-empty) {
          opPrint \$t
          for d in \$present {
            opPrint \$\\"  (\$d)\\"
          }
        }
      }
    }
    outdated => {
      for t in \$tools {
        opPrint \$t
        fileOutdatedTool \$t \$pairs \$dirs
      }
    }
    sync => {
      wutLockHold
      for t in \$tools {
        fileSyncTool \$t \$pairs \$dirs \$perms
      }
    }
    remove => {
      wutLockHold
      for t in \$tools {
        fileRemoveTool \$t \$pairs \$dirs
      }
    }
  }
}


\$env.FILE_LIST_PATH_PAIRS = [ r#'zsh|zsh/zsh/10-vim.zsh|{HOME}/.zsh/10-vim.zsh'#, r#'zsh|zsh/zshenv|{HOME}/.zshenv'#, r#'zsh|zsh/zshrc|{HOME}/.zshrc'# ]

\$env.FILE_LIST_DIRS = [ r#'zsh|{HOME}/.zsh'# ]

\$env.FILE_LIST_PATH_PERMS = [  ]

\$env.FILE_OP = r#'list'#

file

} catch { |e|
  if (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {
    exit 130
  }
  \$e.raw
}
} catch { |e|
  if (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {
    exit 130
  }
  \$e.raw
}"
`;

snapshot[`nu / linux / sync (pinned, no match) 1`] = `
\`try {
try {
\$env.REQ_URL_CFG = r#'http://x/cfg'#

\$env.REQ_URL_SH = r#'http://x/sh/nu/file/sync/nosuchfile?sysOsPlat=linux&wutNuPinned=1'#

def opPrint --wrapped [...args] {
  \$"(\$args | flatten | str join ' ')" | print
}

def opPrintErr --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$"(\$args | flatten | str join ' ')" | print --stderr
    return
  }
  \$"(ansi red)(\$args | flatten | str join ' ')(ansi reset)" | print --stderr
}

def opPrintSucc --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$"(\$args | flatten | str join ' ')" | print
    return
  }
  \$"(ansi green)(\$args | flatten | str join ' ')(ansi reset)" | print
}

def opPrintWarn --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$"(\$args | flatten | str join ' ')" | print
    return
  }
  \$"(ansi yellow)(\$args | flatten | str join ' ')(ansi reset)" | print
}

def opPrintInfo --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$"(\$args | flatten | str join ' ')" | print
    return
  }
  \$"(ansi blue)(\$args | flatten | str join ' ')(ansi reset)" | print
}

def opPrintVerbose --wrapped [...args] {
  if VERBOSE not-in \$env {
    return
  }
  \$"(\$args | flatten | str join ' ')" | print --stderr
}

def opPrintCmd --wrapped [...args] {
  if GRAYSCALE in \$env {
    \$"(\$args | flatten | str join ' ')" | print
    return
  }
  let args = \$args | flatten
  \$"(ansi magenta)(\$args | first)(ansi reset)" | print --no-newline
  if (\$args | length) > 1 {
    \$" (ansi cyan)(\$args | skip 1 | str join ' ')(ansi reset)" | print
  } else {
    print ''
  }
}

def opMaybePrintCmd --wrapped [...args] {
  if DRYRUN not-in \$env {
    opPrintCmd ...\$args
  }
}

# a ctrl-c: nu's own, an input prompt's, or the exit of a command it stopped (130, SIGINT, windows' ctrl-c status)
def opInterrupted [e: record] {
  (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510])
}

# a catch hands its error here first, so a ctrl-c is not stepped past
def opRethrowInterrupt [e: record] {
  if (opInterrupted \$e) {
    \$e.raw
  }
}

# NuSh.quietInterrupt, line for line, for the child nu a command runs in
def opQuietInterrupt [body: string] {
  let stop = [
    r#'if (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {'#
    r#'  exit 130'#
    r#'}'#
    r#'\$e.raw'#
  ] | each { |l| \$"  (\$l)" }
  [r#'try {'# r#'try {'# \$body r#'} catch { |e|'# ...\$stop r#'}'# r#'} catch { |e|'# ...\$stop r#'}'#] | str join "\\\\n"
}

def opRunCmd --wrapped [...args] {
  ^(\$nu.current-exe) --no-config-file -c (opQuietInterrupt \$"(\$args | flatten | str join ' ')")
}

def opRunSilentCmd --wrapped [...args] {
  ^(\$nu.current-exe) --no-config-file -c (opQuietInterrupt \$"(\$args | flatten | str join ' ') o+e> | silent")
}

# a yes/no question: empty, y or yes is yes, and YES answers yes without asking. with no terminal to answer from,
# as under cron or a pipe, it is no: input would fail there with an i/o error
def opAsk [question: string] {
  if 'YES' in \$env {
    return true
  }
  if not (is-terminal --stdin) {
    opPrintWarn \$"(\$question): no terminal to answer from, so no; YES answers yes"
    return false
  }
  # a question starts a step of its own: one blank line before it, and what it lets through right below the answer
  opPrint ''
  let yn = (input \$"(\$question) [[y]/n]: " | str lowercase)
  \$yn in ['' 'y' 'yes']
}

def opMaybeRunCmd --wrapped [...args] {
  if DRYRUN not-in \$env {
    opRunCmd ...\$args
  }
}

def opMaybeRunSilentCmd --wrapped [...args] {
  if DRYRUN not-in \$env {
    opRunSilentCmd ...\$args
  }
}

def opPrintRunCmd --wrapped [...args] {
  opPrintCmd ...\$args
  opRunCmd ...\$args
}

def opPrintMaybeRunCmd --wrapped [...args] {
  opPrintCmd ...\$args
  opMaybeRunCmd ...\$args
}


\$env.SH_VERS_MAJOR = 0

\$env.SH_VERS_MINOR = 116

do {
  let major = \$env.SH_VERS_MAJOR | into int
  let minor = \$env.SH_VERS_MINOR | into int

  if ((version | get major) < \$major) or ((version | get minor) < \$minor) {
    opPrintErr \$"nu must be >= '(\$major).(\$minor)' .. found '(version | get version)' .. aborting"
    exit 1
  }
}


\$env.NU_VERS_MAJOR = 0

\$env.NU_VERS_MINOR = 116

\$env.NU_VERS_PATCH = 0

\$env.REQ_ORIG = r#'http://x'#

\$env.SYS_OS_PLAT = r#'linux'#

\$env.REQ_PATH = r#'/sh/nu/file/sync/nosuchfile'#

\$env.REQ_SRCH = r#'?sysOsPlat=linux&wutNuPinned=1'#

def wutNuVersCurrent [nu_bin: string, nu_vers: string] {
  if not (\$nu_bin | path exists) {
    return false
  }
  let installed = (do { ^\$nu_bin --version } | complete)
  if \$installed.exit_code != 0 {
    return false
  }
  (\$installed.stdout | str trim) == \$nu_vers
}

def wutNuLockRelease [lock_path: string] {
  rm --force \$lock_path
  # best-effort: only succeeds if now empty, so a concurrent process's own in-flight files are never touched
  try { rm (\$lock_path | path dirname) } catch { |e| opRethrowInterrupt \$e }
}

def wutNuInstall [wut_home: string, nu_bin: string, nu_vers: string, ext: string] {
  if (wutNuVersCurrent \$nu_bin \$nu_vers) {
    opPrintVerbose \$"nu (\$nu_vers): current at (\$nu_bin)"
    return
  }
  let found = if (\$nu_bin | path exists) { (do { ^\$nu_bin --version } | complete).stdout | str trim } else { '' }
  opPrintVerbose \$"nu (\$nu_vers): (\$nu_bin) has (if (\$found | is-empty) { 'none' } else { \$found }), syncing"

  let triple = match \$"(\$env.SYS_OS_PLAT)_(\$env.SYS_CPU_ARCH)" {
    'darwin_aarch64' => 'aarch64-apple-darwin',
    'darwin_x86_64' => 'x86_64-apple-darwin',
    'linux_aarch64' => 'aarch64-unknown-linux-gnu',
    'linux_x86_64' => 'x86_64-unknown-linux-gnu',
    'windows_aarch64' => 'aarch64-pc-windows-msvc',
    'windows_x86_64' => 'x86_64-pc-windows-msvc',
    _ => '',
  }
  let gnu_loader = if \$env.SYS_CPU_ARCH == 'aarch64' { '/lib/ld-linux-aarch64.so.1' } else { '/lib64/ld-linux-x86-64.so.2' }
  let musl = (\$triple | str ends-with '-gnu') and ((glob '/lib/ld-musl-*.so.1' | is-not-empty) or not (\$gnu_loader | path exists))
  let triple = if \$musl { \$triple | str replace --regex '-gnu\$' '-musl' } else { \$triple }
  if \$triple == '' {
    opPrintErr \$"unsupported platform/arch for nu sync: (\$env.SYS_OS_PLAT)/(\$env.SYS_CPU_ARCH)"
    exit 1
  }

  # a hidden dir nested inside vendor (not vendor itself) so a fresh download can never collide with the pinned nu_bin path
  let work_dir = (\$wut_home | path join 'vendor' '.nu')
  mkdir \$work_dir

  let lock_path = (\$work_dir | path join 'nu.lock')
  mut acquired = false
  mut waited = 0
  while \$waited < 240 {
    if (wutNuVersCurrent \$nu_bin \$nu_vers) {
      return
    }
    let locked = (try { "" | save \$lock_path; true } catch { |e| opRethrowInterrupt \$e; false })
    if \$locked {
      \$acquired = true
      break
    }
    if \$waited == 0 {
      opPrintVerbose \$"nu (\$nu_vers): waiting on another sync's lock (\$lock_path)"
    }
    sleep 500ms
    \$waited = \$waited + 1
  }
  if not \$acquired {
    opPrintWarn \$"reclaiming stale nu sync lock: (\$lock_path)"
    rm --force \$lock_path
    let locked = (try { "" | save \$lock_path; true } catch { |e| opRethrowInterrupt \$e; false })
    if not \$locked {
      opPrintErr \$"failed to acquire nu sync lock: (\$lock_path)"
      exit 1
    }
  }

  if (wutNuVersCurrent \$nu_bin \$nu_vers) {
    wutNuLockRelease \$lock_path
    return
  }

  let ext_archive = if \$env.SYS_OS_PLAT == 'windows' { 'zip' } else { 'tar.gz' }
  let asset = \$"nu-(\$nu_vers)-(\$triple).(\$ext_archive)"
  let url = \$"https://github.com/nushell/nushell/releases/download/(\$nu_vers)/(\$asset)"
  let archive_path = (\$work_dir | path join \$asset)
  let extract_dir = (\$work_dir | path join \$"nu-(\$nu_vers)-(\$triple)")

  rm --force --recursive \$archive_path \$extract_dir

  opPrintVerbose \$"nu (\$nu_vers): fetching (\$url)"
  let fetched = (do { ^curl --fail-with-body --location --no-progress-meter --output \$archive_path --url \$url } | complete)
  if \$fetched.exit_code != 0 {
    opPrintErr (\$fetched.stderr | str trim)
    opPrintErr \$"failed to download nu (\$nu_vers): (\$url)"
    rm --force \$archive_path
    wutNuLockRelease \$lock_path
    exit 1
  }

  let sums_url = \$"https://github.com/nushell/nushell/releases/download/(\$nu_vers)/SHA256SUMS"
  opPrintVerbose \$"nu (\$nu_vers): checking against (\$sums_url)"
  let sums = (do { ^curl --fail-with-body --location --no-progress-meter --url \$sums_url } | complete)
  let want = (\$sums.stdout | lines | split column --regex '\\\\s+' sum name | where name == \$asset | get -o 0.sum | default '')
  let got = (open --raw \$archive_path | hash sha256)
  if \$sums.exit_code != 0 or (\$want | is-empty) or \$got != \$want {
    opPrintErr \$"nu (\$nu_vers): (\$asset) does not match the release's SHA256SUMS"
    rm --force \$archive_path
    wutNuLockRelease \$lock_path
    exit 1
  }

  # zip assets (windows) have no wrapping folder, unlike tar.gz assets, so they must extract directly into
  # extract_dir; tar.gz assets already contain their own nu-(\$nu_vers)-(\$triple) folder, so they extract into work_dir
  let extract_target = if \$ext_archive == 'zip' {
    mkdir \$extract_dir
    \$extract_dir
  } else {
    \$work_dir
  }
  opPrintVerbose \$"nu (\$nu_vers): extracting into (\$extract_target)"
  let extracted = (do { ^tar -xf \$archive_path -C \$extract_target } | complete)
  if \$extracted.exit_code != 0 {
    opPrintErr (\$extracted.stderr | str trim)
    opPrintErr \$"failed to extract nu (\$nu_vers)"
    rm --force --recursive \$archive_path \$extract_dir
    wutNuLockRelease \$lock_path
    exit 1
  }

  let extracted_bin = (\$extract_dir | path join \$"nu(\$ext)")
  if not (\$extracted_bin | path exists) {
    opPrintErr \$"nu binary not found in extracted archive: (\$extract_dir)"
    rm --force --recursive \$archive_path \$extract_dir
    wutNuLockRelease \$lock_path
    exit 1
  }

  if \$env.SYS_OS_PLAT != 'windows' {
    ^chmod +x \$extracted_bin
  }
  mv --force \$extracted_bin \$nu_bin
  rm --force --recursive \$archive_path \$extract_dir
  opPrintVerbose \$"nu (\$nu_vers): installed at (\$nu_bin)"

  wutNuLockRelease \$lock_path
}

def --env wutNuSync [] {
  if \$env.SYS_OS_PLAT not-in ['darwin' 'linux' 'windows'] {
    opPrintWarn 'script is for darwin, linux, or windows'
    return
  }

  # windows has no HOME, and default's argument is evaluated even when WUT_HOME is set, so nu's own answer stands in,
  # as it does for the lock
  \$env.WUT_HOME = (\$env.WUT_HOME? | default (\$nu.home-dir | path join '.wut'))
  let wut_home = \$env.WUT_HOME
  let ext = if \$env.SYS_OS_PLAT == 'windows' { '.exe' } else { '' }
  let nu_bin = (\$wut_home | path join 'vendor' \$"nu(\$ext)")
  let nu_vers = \$"(\$env.NU_VERS_MAJOR).(\$env.NU_VERS_MINOR).(\$env.NU_VERS_PATCH)"

  wutNuInstall \$wut_home \$nu_bin \$nu_vers \$ext
}

wutNuSync

# pwsh's module dirs would otherwise leak into windows powershell (scoop)
if \$env.SYS_OS_PLAT == 'windows' {
  hide-env -i PSModulePath
}


# a tool this run installed, or one installed since the calling shell started, lands somewhere that shell's PATH may
# not reach yet. the env stage wut deploys already knows every such place, and adds each once it exists, so the run
# asks the native shell for the PATH a new one would start with, rather than leaving the next step to find nothing.
# windows keeps PATH in the registry too, where installers record theirs, so that joins what the profile builds
def --env wutPathRefresh [] {
  let out = if \$env.SYS_OS_PLAT? == 'windows' {
    if (which pwsh | is-empty) {
      return
    }
    let cmd = "\$sep = [IO.Path]::PathSeparator; \$reg = @('Machine', 'User') | ForEach-Object { [Environment]::GetEnvironmentVariable('Path', \$_) }; (((\$env:PATH -split \$sep) + (\$reg -split \$sep)) | Where-Object { \$_ } | Select-Object -Unique) -join \$sep"
    ^pwsh -NoLogo -Command \$cmd | complete
  } else {
    if (which zsh | is-empty) {
      return
    }
    ^zsh -c 'print -r -- \$PATH' | complete
  }
  # the last line, since an env stage is free to print on its way through
  let path = (\$out.stdout | lines | where { is-not-empty } | last 1 | get -o 0)
  if \$out.exit_code != 0 or \$path == null {
    return
  }
  \$env.PATH = (\$path | split row (char esep) | where { is-not-empty } | uniq)
}


wutPathRefresh

\$env.FILE_SYNC_PARTS = r#'nosuchfile'#

opPrintWarn r#'no file matched: nosuchfile'#

} catch { |e|
  if (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {
    exit 130
  }
  \$e.raw
}
} catch { |e|
  if (\$e.debug | str starts-with 'Interrupted ') or (\$e.details.code? == 'nu::shell::io::interrupted') or (\$e.exit_code? in [130, -2, -1073741510]) {
    exit 130
  }
  \$e.raw
}\`
`;

